<% content_for :title, "Dashboard — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "dashboard" %>

  <main class="app-content">
    <div style="margin-bottom:4px;">
      <h1 class="page-title" style="margin-bottom:4px;">Olá, <%= current_person.name.split.first %> 👋</h1>
      <p class="page-subtitle" style="margin:0;">Bem-vindo(a) ao Click.People — sua plataforma de gestão de pessoas.</p>
    </div>

    <%# ── Active cycle banner ── %>
    <% if @active_cycle %>
      <div style="margin-top:24px;background:linear-gradient(135deg,#fff5f0 0%,#fff 100%);border:1.5px solid var(--color-accent);border-radius:var(--radius-md);padding:20px 24px;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="width:40px;height:40px;border-radius:50%;background:var(--color-accent);display:flex;align-items:center;justify-content:center;">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div>
              <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-accent);margin-bottom:2px;">Ciclo ativo</div>
              <div style="font-size:16px;font-weight:700;"><%= @active_cycle.name %></div>
              <div style="font-size:13px;color:var(--color-text-secondary);"><%= @active_cycle.current_phase_label %></div>
            </div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <% if @active_cycle.nominations_open? && @is_participant %>
              <%= link_to "Fazer indicações →", cycle_nominations_path(@active_cycle), class: "btn btn-primary", style: "font-size:13px;" %>
            <% end %>
            <% if @active_cycle.validating? %>
              <%= link_to "Validar indicações →", validate_index_cycle_nominations_path(@active_cycle), class: "btn btn-primary", style: "font-size:13px;" %>
            <% end %>
            <% if @active_cycle.evaluation_open? && @my_pending_evaluations > 0 %>
              <%= link_to "Responder avaliações (#{@my_pending_evaluations}) →", evaluations_path, class: "btn btn-primary", style: "font-size:13px;" %>
            <% end %>
            <% if @active_cycle.calibration? || @active_cycle.closed? %>
              <%= link_to "Ver 9-Box →", cycle_nine_box_path(@active_cycle), style: "font-size:13px;font-weight:600;color:var(--color-accent);text-decoration:none;padding:8px 16px;border:1.5px solid var(--color-accent);border-radius:var(--radius-pill);" %>
            <% end %>
            <%= link_to "Ver ciclo", cycle_path(@active_cycle), style: "font-size:13px;font-weight:500;color:var(--color-text-secondary);text-decoration:none;padding:8px 16px;border:1px solid var(--color-border);border-radius:var(--radius-pill);" %>
          </div>
        </div>
        <% if @active_cycle.evaluation_open? && @my_pending_evaluations > 0 %>
          <div style="margin-top:12px;padding-top:12px;border-top:1px solid #fdd0c0;">
            <p style="font-size:13px;color:var(--color-accent);font-weight:600;margin:0;">
              Você tem <%= @my_pending_evaluations %> avaliação(ões) pendente(s). Prazo: <%= @active_cycle.evaluation_end&.strftime("%d/%m/%Y") || "não definido" %>.
            </p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# ── Stats ── %>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px;">
      <div class="card" style="padding:20px;">
        <div style="font-size:28px;font-weight:700;color:var(--color-text);"><%= @total_people %></div>
        <div style="font-size:13px;color:var(--color-text-secondary);margin-top:2px;">Colaboradores ativos</div>
      </div>
      <div class="card" style="padding:20px;">
        <div style="font-size:28px;font-weight:700;color:<%= @active_cycle ? 'var(--color-accent)' : 'var(--color-text)' %>;"><%= @active_cycle ? @active_cycle.current_phase_label : "Nenhum" %></div>
        <div style="font-size:13px;color:var(--color-text-secondary);margin-top:2px;">Fase do ciclo ativo</div>
      </div>
      <div class="card" style="padding:20px;">
        <div style="font-size:28px;font-weight:700;color:<%= @my_pending_evaluations > 0 ? 'var(--color-accent)' : 'var(--color-text)' %>;"><%= @my_pending_evaluations %></div>
        <div style="font-size:13px;color:var(--color-text-secondary);margin-top:2px;">Avaliações pendentes suas</div>
      </div>
    </div>

    <%# ── Recent cycles ── %>
    <% if @recent_cycles.any? %>
      <div style="margin-top:28px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <h2 style="font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--color-text-secondary);margin:0;">Ciclos recentes</h2>
          <%= link_to "Ver todos →", cycles_path, style: "font-size:13px;color:var(--color-accent);text-decoration:none;font-weight:600;" %>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <% @recent_cycles.each do |cycle| %>
            <div class="card" style="padding:14px 18px;display:flex;align-items:center;gap:12px;">
              <div style="flex:1;">
                <span style="font-size:14px;font-weight:600;"><%= cycle.name %></span>
                <span style="font-size:12px;color:var(--color-text-secondary);margin-left:8px;"><%= cycle.created_at.strftime("%d/%m/%Y") %></span>
              </div>
              <span class="cycle-badge cycle-badge--<%= cycle.status %>"><%= cycle.current_phase_label %></span>
              <%= link_to "Ver", cycle_path(cycle), style: "font-size:13px;color:var(--color-accent);text-decoration:none;font-weight:600;margin-left:8px;" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── Quick actions (admin only) ── %>
    <% if current_person.hr_admin? || current_person.business_partner? %>
      <div style="margin-top:28px;">
        <h2 style="font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--color-text-secondary);margin:0 0 12px;">Ações rápidas</h2>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
          <% [
            ["Adicionar colaborador", new_admin_person_path, "M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"],
            ["Novo ciclo",            new_cycle_path,        "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"],
            ["Ver colaboradores",     admin_people_path,     "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"],
          ].each do |label, path, icon_path| %>
            <%= link_to path, style: "text-decoration:none;" do %>
              <div class="card" style="padding:16px;display:flex;align-items:center;gap:12px;cursor:pointer;">
                <div style="width:36px;height:36px;border-radius:50%;background:var(--color-surface-alt);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-accent)" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>"/></svg>
                </div>
                <span style="font-size:14px;font-weight:600;"><%= label %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

  </main>
</div>
