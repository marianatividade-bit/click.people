<% content_for :title, "Home — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "home" %>

  <main class="app-content">
    <h1 class="page-title">Olá, <%= current_person.name.split(" ").first %> 👋</h1>
    <p class="page-subtitle">
      <% role_label = { "hr_admin" => "RH Admin", "business_partner" => "Business Partner", "director" => "Director", "manager" => "Manager", "employee" => "Colaborador" } %>
      <%= role_label[current_person.role] || current_person.role.humanize %>
      · Click.People
    </p>

    <% if current_person.hr_admin? || current_person.business_partner? %>
      <%# === HR / BP === %>
      <div class="stat-row">
        <div class="stat-card">
          <div class="stat-label">Ciclo ativo</div>
          <div class="stat-value"><%= @open_cycle&.name || "—" %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Pessoas ativas</div>
          <div class="stat-value"><%= @people_count %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Avaliações em rascunho</div>
          <div class="stat-value"><%= @pending_evals %></div>
        </div>
      </div>

      <% if @open_cycle %>
        <div class="card" style="margin-bottom:16px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <div style="font-size:15px;font-weight:700;">Ciclo aberto: <%= @open_cycle.name %></div>
            <%= link_to "Ver progresso →", progress_cycle_path(@open_cycle), style: "font-size:13px;color:var(--color-accent);text-decoration:none;font-weight:600;" %>
          </div>
          <div style="font-size:13px;color:var(--color-text-secondary);">
            Deadline: <%= @open_cycle.evaluation_deadline&.strftime("%d/%m/%Y") || "Não definido" %>
          </div>
        </div>
      <% end %>

      <div style="display:flex;gap:12px;margin-top:8px;">
        <%= link_to "Gerenciar pessoas", people_path, class: "btn btn-secondary" %>
        <%= link_to "Ver ciclos", cycles_path, class: "btn btn-secondary" %>
        <%= link_to "9-Box", nine_box_path, class: "btn btn-secondary" %>
      </div>

    <% elsif current_person.director? %>
      <%# === Director === %>
      <div class="stat-row">
        <div class="stat-card">
          <div class="stat-label">Ciclo ativo</div>
          <div class="stat-value"><%= @open_cycle&.name || "—" %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Pessoas no time</div>
          <div class="stat-value"><%= @team.count %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Avaliações do time</div>
          <div class="stat-value"><%= @team_eval_count %></div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <div style="font-size:15px;font-weight:700;margin-bottom:12px;">Seu time</div>
        <% if @team.any? %>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <% @team.limit(5).each do |member| %>
              <%= link_to person_path(member), style: "text-decoration:none;display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--color-border);" do %>
                <div style="width:32px;height:32px;border-radius:50%;background:var(--color-accent);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;flex-shrink:0;">
                  <%= member.name.split(" ").first(2).map{|n|n[0]}.join %>
                </div>
                <div>
                  <div style="font-size:14px;font-weight:600;color:var(--color-text);"><%= member.name %></div>
                  <div style="font-size:12px;color:var(--color-text-secondary);"><%= member.role.humanize %></div>
                </div>
              <% end %>
            <% end %>
            <% if @team.count > 5 %>
              <div style="font-size:13px;color:var(--color-text-secondary);padding-top:4px;">
                + <%= @team.count - 5 %> mais. <%= link_to "Ver todos", people_path, style: "color:var(--color-accent);" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p style="color:var(--color-text-secondary);font-size:14px;margin:0;">Nenhum report direto encontrado.</p>
        <% end %>
      </div>

    <% elsif current_person.manager? %>
      <%# === Manager === %>
      <div class="stat-row">
        <div class="stat-card">
          <div class="stat-label">Ciclo ativo</div>
          <div class="stat-value"><%= @open_cycle&.name || "—" %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Reports diretos</div>
          <div class="stat-value"><%= @direct_reports.count %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Avaliações enviadas</div>
          <div class="stat-value"><%= @my_evals.submitted.count rescue 0 %></div>
        </div>
      </div>

      <% if @open_cycle %>
        <div class="card" style="margin-bottom:16px;">
          <div style="font-size:15px;font-weight:700;margin-bottom:12px;">Avaliações neste ciclo</div>
          <% if @my_evals.any? %>
            <% @my_evals.each do |ev| %>
              <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--color-border);">
                <span style="font-size:14px;"><%= ev.evaluated.name %></span>
                <span class="cycle-badge cycle-badge--<%= ev.draft? ? 'draft' : 'open' %>">
                  <%= ev.draft? ? "Rascunho" : "Enviada" %>
                </span>
              </div>
            <% end %>
          <% else %>
            <p style="color:var(--color-text-secondary);font-size:14px;margin:0;">
              Nenhuma avaliação ainda.
              <%= link_to "Criar avaliação →", new_evaluation_path, style: "color:var(--color-accent);" %>
            </p>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <%# === Colaborador === %>
      <div class="stat-row">
        <div class="stat-card">
          <div class="stat-label">Ciclo ativo</div>
          <div class="stat-value"><%= @open_cycle&.name || "—" %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">PDIs ativos</div>
          <div class="stat-value"><%= @my_pdis&.count || 0 %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Feedbacks recebidos</div>
          <div class="stat-value"><%= @recent_feedback&.count || 0 %></div>
        </div>
      </div>

      <% if @open_cycle %>
        <div class="card" style="margin-bottom:16px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
            <div style="font-size:15px;font-weight:700;">Ciclo: <%= @open_cycle.name %></div>
          </div>
          <% if @my_evals.any? %>
            <% @my_evals.each do |ev| %>
              <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--color-border);">
                <%= link_to ev.evaluated.name, evaluation_path(ev), style: "font-size:14px;color:var(--color-accent);text-decoration:none;" %>
                <span class="cycle-badge cycle-badge--<%= ev.draft? ? 'draft' : 'open' %>">
                  <%= ev.draft? ? "Rascunho" : "Enviada" %>
                </span>
              </div>
            <% end %>
          <% else %>
            <p style="color:var(--color-text-secondary);font-size:14px;margin:0;">
              Sem avaliações neste ciclo.
            </p>
          <% end %>
        </div>
      <% end %>

      <% if @my_pdis&.any? %>
        <div class="card" style="margin-bottom:16px;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <div style="font-size:15px;font-weight:700;">Meus PDIs</div>
            <%= link_to "Ver todos →", pdis_path, style: "font-size:13px;color:var(--color-accent);text-decoration:none;font-weight:600;" %>
          </div>
          <% @my_pdis.each do |pdi| %>
            <div style="padding:8px 0;border-bottom:1px solid var(--color-border);">
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <%= link_to pdi.title, pdi_path(pdi), style: "font-size:14px;font-weight:600;color:var(--color-text);text-decoration:none;" %>
                <span class="pdi-badge pdi-badge--<%= pdi.status %>"><%= pdi.status.humanize %></span>
              </div>
              <div class="progress-bar-wrap" style="margin-top:4px;">
                <div class="progress-bar-fill" style="width:<%= pdi.progress_percent %>%;"></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div style="display:flex;gap:12px;margin-top:8px;">
        <%= link_to "Dar feedback", new_feedback_path, class: "btn btn-primary" %>
        <%= link_to "Meus PDIs", pdis_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </main>
</div>
