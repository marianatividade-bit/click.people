<% gestao_active = %w[cycles ninebox evaluations pdis recovery_plans feedbacks].include?(active) %>

<aside class="app-sidebar">
  <div class="sidebar-logo">
    <span>Click.People</span>
  </div>

  <nav class="sidebar-nav">
    <%= link_to root_path, class: (active == "home" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Home
    <% end %>

    <%= link_to people_path, class: (active == "people" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      Pessoas
    <% end %>

    <%# === Gestão de Desempenho === %>
    <div class="nav-group">
      <div class="nav-group-label <%= gestao_active ? 'nav-group-label--active' : '' %>">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Gestão de Desempenho
      </div>
      <div class="nav-group-items">
        <%= link_to cycles_path, class: "nav-sub-item #{%w[cycles ninebox evaluations].include?(active) ? 'active' : ''}" do %>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Avaliação de desempenho
        <% end %>

        <%= link_to pdis_path, class: "nav-sub-item #{active == 'pdis' ? 'active' : ''}" do %>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          PDI
        <% end %>

        <%= link_to recovery_plans_path, class: "nav-sub-item #{active == 'recovery_plans' ? 'active' : ''}" do %>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Plano de Recuperação
        <% end %>

        <%= link_to feedbacks_path, class: "nav-sub-item #{active == 'feedbacks' ? 'active' : ''}" do %>
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          Feedbacks
        <% end %>
      </div>
    </div>

    <%= link_to notifications_path, class: (active == "notifications" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Notificações
      <% unread = current_person.notifications.unread.count %>
      <% if unread > 0 %>
        <span style="background:var(--color-accent);color:#fff;border-radius:var(--radius-pill);font-size:11px;font-weight:700;padding:1px 6px;margin-left:auto;"><%= unread %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="sidebar-footer">
    <span class="person-name"><%= current_person.name %></span>
    <%= button_to "Sair", destroy_person_session_path, method: :delete,
          data: { turbo: false },
          style: "background:none; border:none; padding:0; color:var(--color-text-secondary); font-size:13px; cursor:pointer; font-family:var(--font-sans);" %>
  </div>
</aside>
