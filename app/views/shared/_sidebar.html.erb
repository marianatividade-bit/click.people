<aside class="app-sidebar">
  <div class="sidebar-logo">
    <span>Click.People</span>
  </div>

  <nav class="sidebar-nav">
    <%= link_to root_path, class: (active == "home" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Home
    <% end %>

    <%= link_to cycles_path, class: (active == "cycles" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      Ciclos
    <% end %>

    <%= link_to people_path, class: (active == "people" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      Pessoas
    <% end %>

    <%= link_to nine_box_path, class: (active == "ninebox" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
      9-Box
    <% end %>

    <%= link_to evaluations_path, class: (active == "evaluations" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Avaliações
    <% end %>

    <%= link_to pdis_path, class: (active == "pdis" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      PDIs
    <% end %>

    <%= link_to feedbacks_path, class: (active == "feedbacks" ? "active" : "") do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
      Feedbacks
    <% end %>

    <%= link_to notifications_path, class: (active == "notifications" ? "active" : ""), style: "position:relative;" do %>
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Notificações
      <% unread = current_person.notifications.unread.count %>
      <% if unread > 0 %>
        <span style="background:var(--color-accent);color:#fff;border-radius:var(--radius-pill);font-size:11px;font-weight:700;padding:1px 6px;margin-left:auto;"><%= unread %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="sidebar-footer">
    <span class="person-name"><%= current_person.name %></span>
    <%= button_to "Sair", destroy_person_session_path, method: :delete,
          style: "background:none; border:none; padding:0; color:var(--color-text-secondary); font-size:13px; cursor:pointer; font-family:var(--font-sans);" %>
  </div>
</aside>
