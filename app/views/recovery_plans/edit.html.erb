<% content_for :title, "Editar Plano de Recuperação — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "recovery_plans" %>

  <main class="app-content">
    <%= link_to "← #{@plan.title}", recovery_plan_path(@plan), style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <h1 class="page-title">Editar Plano de Recuperação</h1>

    <%= form_with model: @plan, local: true do |f| %>
      <div class="card" style="max-width:640px;margin-bottom:16px;">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:var(--color-text-secondary);margin-bottom:16px;">Sobre o plano</div>

        <div class="form-field">
          <%= f.label :person_id, "Colaborador", class: "form-label" %>
          <%= f.select :person_id, @people.map{|p| [p.name, p.id]}, {}, class: "form-input" %>
        </div>
        <div class="form-field">
          <%= f.label :title, "Título", class: "form-label" %>
          <%= f.text_field :title, class: "form-input" %>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
          <div class="form-field" style="margin-bottom:0;">
            <%= f.label :status, "Status", class: "form-label" %>
            <%= f.select :status, [["Ativo","active"],["Concluído","completed"],["Cancelado","cancelled"]], {}, class: "form-input" %>
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <%= f.label :due_date, "Prazo", class: "form-label" %>
            <%= f.date_field :due_date, class: "form-input" %>
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <%= f.label :cycle_id, "Ciclo", class: "form-label" %>
            <%= f.select :cycle_id, @cycles.map{|c| [c.name, c.id]}, { include_blank: "Sem vínculo" }, class: "form-input" %>
          </div>
        </div>
      </div>

      <div class="card" style="max-width:640px;margin-bottom:16px;">
        <div class="form-field">
          <%= f.label :reason, "Motivo", class: "form-label" %>
          <%= f.text_area :reason, rows: 3, class: "form-input" %>
        </div>
        <div class="form-field">
          <%= f.label :description, "Expectativas", class: "form-label" %>
          <%= f.text_area :description, rows: 3, class: "form-input" %>
        </div>
        <div class="form-field" style="margin-bottom:0;">
          <%= f.label :outcome, "Desfecho (ao encerrar)", class: "form-label" %>
          <%= f.text_area :outcome, rows: 3, class: "form-input", placeholder: "Descreva o resultado final do plano..." %>
        </div>
      </div>

      <div style="display:flex;gap:12px;">
        <%= f.submit "Salvar", class: "btn btn-primary" %>
        <%= link_to "Cancelar", recovery_plan_path(@plan), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </main>
</div>
