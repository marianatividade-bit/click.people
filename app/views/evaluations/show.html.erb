<% content_for :title, "Avaliação — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "evaluations" %>

  <main class="app-content" style="max-width:720px;">
    <%= link_to "← Minhas avaliações", evaluations_path, style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <div class="card" style="margin-bottom:24px;padding:20px;">
      <div style="display:flex;align-items:center;gap:14px;">
        <%= person_avatar(@evaluation.evaluated, size: 52, font_size: 20) %>
        <div style="flex:1;">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin-bottom:2px;"><%= @evaluation.type_label %></div>
          <div style="font-size:18px;font-weight:700;"><%= @evaluation.self_eval? ? "Sua autoavaliação" : @evaluation.evaluated.name %></div>
          <div style="font-size:13px;color:var(--color-text-secondary);"><%= @evaluation.cycle.name %> · Enviada <%= @evaluation.completed_at&.strftime("%d/%m/%Y") %></div>
        </div>
        <span style="font-size:12px;font-weight:700;background:#dcfce7;color:#14532d;padding:4px 12px;border-radius:var(--radius-pill);">Concluída</span>
      </div>
    </div>

    <% current_dimension = nil %>
    <% @questions.each do |question| %>
      <% if question.dimension != current_dimension %>
        <% current_dimension = question.dimension %>
        <div style="margin:24px 0 12px;">
          <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);"><%= question.dimension_label %></span>
        </div>
      <% end %>

      <% answer = @answers[question.id] %>
      <div class="card" style="margin-bottom:10px;">
        <p style="font-size:14px;font-weight:600;margin:0 0 12px;line-height:1.5;"><%= question.text %></p>
        <% if question.numeric? %>
          <div style="display:flex;gap:6px;">
            <% (question.min_score..question.max_score).each do |score| %>
              <% selected = answer&.numeric_value&.to_i == score %>
              <div style="width:40px;height:40px;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;background:<%= selected ? 'var(--color-accent)' : 'var(--color-surface-alt)' %>;color:<%= selected ? '#fff' : 'var(--color-text-secondary)' %>;"><%= score %></div>
            <% end %>
          </div>
        <% else %>
          <p style="font-size:14px;color:var(--color-text);background:var(--color-surface-alt);padding:12px;border-radius:var(--radius-md);margin:0;line-height:1.6;"><%= answer&.text_value || "—" %></p>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
