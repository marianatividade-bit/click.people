<% content_for :title, "Avaliação de #{@evaluation.evaluated.name}" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "evaluations" %>

  <main class="app-content">
    <%= link_to "← Avaliações", evaluations_path, style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <div style="display:flex;align-items:center;gap:16px;margin-bottom:4px;">
      <h1 class="page-title" style="margin-bottom:0;">Avaliação de <%= @evaluation.evaluated.name %></h1>
      <span class="cycle-badge cycle-badge--<%= @evaluation.draft? ? 'draft' : 'open' %>">
        <%= @evaluation.draft? ? "Rascunho" : "Enviada" %>
      </span>
    </div>
    <p class="page-subtitle"><%= @evaluation.cycle.name %></p>

    <%= form_with model: @evaluation, local: true do |f| %>
      <div class="card" style="max-width:600px; margin-bottom:16px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-field" style="margin-bottom:0;">
            <%= f.label :performance_score, "Desempenho (1–5)", class: "form-label" %>
            <%= f.number_field :performance_score, min: 1, max: 5, step: 0.5, class: "form-input",
                  disabled: @evaluation.submitted? %>
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <%= f.label :potential_score, "Potencial (1–5)", class: "form-label" %>
            <%= f.number_field :potential_score, min: 1, max: 5, step: 0.5, class: "form-input",
                  disabled: @evaluation.submitted? %>
          </div>
        </div>
      </div>

      <div class="card" style="max-width:600px; margin-bottom:16px;">
        <div class="form-field">
          <%= f.label :strengths, "Pontos fortes", class: "form-label" %>
          <%= f.text_area :strengths, rows: 3, class: "form-input",
                disabled: @evaluation.submitted? %>
        </div>
        <div class="form-field">
          <%= f.label :improvements, "Pontos de desenvolvimento", class: "form-label" %>
          <%= f.text_area :improvements, rows: 3, class: "form-input",
                disabled: @evaluation.submitted? %>
        </div>
        <div class="form-field" style="margin-bottom:0;">
          <%= f.label :overall_comment, "Comentário geral", class: "form-label" %>
          <%= f.text_area :overall_comment, rows: 3, class: "form-input",
                disabled: @evaluation.submitted? %>
        </div>
      </div>

      <% if @evaluation.draft? %>
        <div style="display:flex;gap:12px;">
          <%= f.submit "Salvar rascunho", class: "btn btn-secondary" %>
          <%= f.submit "Enviar avaliação →", name: "submit", class: "btn btn-primary",
                data: { confirm: "Confirma envio? Não poderá editar após enviar." } %>
        </div>
      <% end %>
    <% end %>
  </main>
</div>
