<% content_for :title, "Organização — Admin" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "admin_dashboard" %>

  <main class="app-content">
    <h1 class="page-title">Organização</h1>
    <p class="page-subtitle">Painel administrativo — visível apenas para RH Admin e Business Partner</p>

    <%# Visão geral %>
    <div class="stat-row" style="margin-bottom:32px;">
      <div class="stat-card">
        <div class="stat-label">Colaboradores ativos</div>
        <div class="stat-value"><%= @people_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Inativos</div>
        <div class="stat-value"><%= @inactive_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Cargos cadastrados</div>
        <div class="stat-value"><%= @cargos_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Avaliações em rascunho</div>
        <div class="stat-value"><%= @pending_evals %></div>
      </div>
    </div>

    <%# Cards de configuração %>
    <h2 style="font-size:15px;font-weight:700;margin:0 0 16px;">Gestão</h2>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:32px;">

      <%= link_to people_path, style: "text-decoration:none;" do %>
        <div class="admin-config-card">
          <div class="admin-config-icon">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <div class="admin-config-label">Colaboradores</div>
          <div class="admin-config-desc">Gerenciar pessoas, papéis e lideranças</div>
        </div>
      <% end %>

      <%= link_to admin_cargos_path, style: "text-decoration:none;" do %>
        <div class="admin-config-card">
          <div class="admin-config-icon">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          </div>
          <div class="admin-config-label">Cargos</div>
          <div class="admin-config-desc">Cadastrar e organizar cargos por nível</div>
        </div>
      <% end %>

      <%= link_to cycles_path, style: "text-decoration:none;" do %>
        <div class="admin-config-card">
          <div class="admin-config-icon">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="admin-config-label">Ciclos de avaliação</div>
          <div class="admin-config-desc">Criar e gerenciar ciclos de desempenho</div>
        </div>
      <% end %>

      <%= link_to recovery_plans_path, style: "text-decoration:none;" do %>
        <div class="admin-config-card">
          <div class="admin-config-icon">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="admin-config-label">Planos de Recuperação</div>
          <div class="admin-config-desc">Acompanhar planos de melhoria ativos</div>
        </div>
      <% end %>

      <%= link_to nine_box_path, style: "text-decoration:none;" do %>
        <div class="admin-config-card">
          <div class="admin-config-icon">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <div class="admin-config-label">9-Box</div>
          <div class="admin-config-desc">Calibração de desempenho e potencial</div>
        </div>
      <% end %>

      <%= link_to notifications_path, style: "text-decoration:none;" do %>
        <div class="admin-config-card">
          <div class="admin-config-icon">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          </div>
          <div class="admin-config-label">Notificações</div>
          <div class="admin-config-desc">Enviar comunicados e alertas</div>
        </div>
      <% end %>

    </div>

    <% if @open_cycle %>
      <div class="card" style="max-width:640px;">
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <div>
            <div style="font-size:15px;font-weight:700;margin-bottom:2px;">Ciclo aberto: <%= @open_cycle.name %></div>
            <div style="font-size:13px;color:var(--color-text-secondary);">
              Deadline: <%= @open_cycle.evaluation_deadline&.strftime("%d/%m/%Y") || "Não definido" %>
            </div>
          </div>
          <%= link_to "Ver progresso →", progress_cycle_path(@open_cycle), class: "btn btn-secondary", style: "font-size:13px;" %>
        </div>
      </div>
    <% end %>
  </main>
</div>
