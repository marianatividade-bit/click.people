<% content_for :title, "Novo Colaborador — Admin" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "admin_people" %>

  <main class="app-content">
    <%= link_to "← Colaboradores", admin_people_path, style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <h1 class="page-title" style="margin-bottom:4px;">Novo colaborador</h1>
    <p class="page-subtitle" style="margin:0 0 28px;">Preencha os dados e defina o nível de acesso. O colaborador receberá acesso ao fazer o primeiro login com o Google.</p>

    <%= form_with model: [:admin, @person], local: true, multipart: true do |f| %>
      <% if @person.errors.any? %>
        <div style="max-width:820px;margin-bottom:16px;padding:14px 18px;background:#fff5f5;border-left:3px solid #e53e3e;border-radius:var(--radius-md);">
          <% @person.errors.full_messages.each do |msg| %>
            <p style="margin:0 0 2px;font-size:13px;color:#c53030;"><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div style="display:grid;grid-template-columns:180px 1fr;gap:20px;max-width:820px;align-items:start;">

        <%# ── Painel esquerdo: avatar ── %>
        <div class="card" style="padding:24px 16px;text-align:center;">
          <div id="avatar-preview" style="width:72px;height:72px;border-radius:50%;background:var(--color-surface-alt);border:2px dashed var(--color-border);display:flex;align-items:center;justify-content:center;margin:0 auto 10px;overflow:hidden;">
            <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="var(--color-text-secondary)" stroke-width="1.5"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>

          <div style="margin-top:10px;">
            <%= f.label :photo, "Adicionar foto",
                  style: "display:inline-block;font-size:12px;font-weight:600;color:var(--color-accent);cursor:pointer;border:1.5px solid var(--color-accent);border-radius:var(--radius-pill);padding:5px 12px;" %>
            <%= f.file_field :photo, accept: "image/*", style: "display:none;", onchange: "previewAvatar(this)" %>
          </div>
          <p style="font-size:11px;color:var(--color-text-secondary);margin:8px 0 0;line-height:1.4;">Opcional — pode<br>adicionar depois</p>
        </div>

        <%# ── Painel direito: formulário ── %>
        <div>

          <%# Seção: dados básicos %>
          <div class="card" style="margin-bottom:16px;">
            <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 16px;">Informações básicas</p>

            <div class="form-field">
              <%= f.label :name, "Nome completo", class: "form-label" %>
              <%= f.text_field :name, class: "form-input", placeholder: "Ex: Ana Paula Lima" %>
            </div>

            <div class="form-field" style="margin-bottom:0;">
              <%= f.label :email, "E-mail corporativo", class: "form-label" %>
              <%= f.email_field :email, class: "form-input", placeholder: "ana.lima@clicksign.com" %>
              <p style="margin:4px 0 0;font-size:12px;color:var(--color-text-secondary);">Deve ser o e-mail Google usado para login</p>
            </div>
          </div>

          <%# Seção: acesso %>
          <div class="card" style="margin-bottom:16px;">
            <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 16px;">Acesso e papel</p>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <% roles = [
                { value: "employee",         label: "Colaborador",       desc: "Acessa seus próprios dados" },
                { value: "manager",          label: "Gestor",            desc: "Acessa o time que lidera" },
                { value: "director",         label: "Diretor",           desc: "Acessa diretoria e times" },
                { value: "hr_admin",         label: "RH Admin",          desc: "Acesso total + admin" },
                { value: "business_partner", label: "Business Partner",  desc: "Visão parcial de RH" },
              ] %>
              <% roles.each do |r| %>
                <label style="display:flex;align-items:flex-start;gap:10px;padding:12px;border:1.5px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;transition:border-color .15s;"
                       onmouseover="this.style.borderColor='var(--color-accent)'"
                       onmouseout="if(!this.querySelector('input').checked) this.style.borderColor='var(--color-border)'"
                       onclick="document.querySelectorAll('.role-card').forEach(c=>c.style.borderColor='var(--color-border)'); this.style.borderColor='var(--color-accent)';"
                       class="role-card">
                  <%= f.radio_button :role, r[:value], style: "margin-top:2px;accent-color:var(--color-accent);flex-shrink:0;" %>
                  <div>
                    <div style="font-size:13px;font-weight:600;margin-bottom:2px;"><%= r[:label] %></div>
                    <div style="font-size:11px;color:var(--color-text-secondary);line-height:1.3;"><%= r[:desc] %></div>
                  </div>
                </label>
              <% end %>
            </div>
          </div>

          <%# Seção: estrutura org %>
          <div class="card" style="margin-bottom:0;">
            <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 16px;">Estrutura organizacional</p>

            <div class="form-field">
              <%= f.label :chapter_manager_id, "Gestor de Chapter", class: "form-label" %>
              <%= f.select :chapter_manager_id,
                Person.order(:name).map { |p| [p.name, p.id] },
                { include_blank: "— sem gestor —" },
                class: "form-input" %>
            </div>

            <div class="form-field" style="margin-bottom:0;">
              <%= f.label :stream_manager_id, "Gestor de Stream", class: "form-label" %>
              <%= f.select :stream_manager_id,
                Person.order(:name).map { |p| [p.name, p.id] },
                { include_blank: "— sem gestor —" },
                class: "form-input" %>
            </div>
          </div>

        </div><%# fim painel direito %>
      </div><%# fim grid %>

      <div style="display:flex;gap:12px;margin-top:24px;max-width:820px;justify-content:flex-end;">
        <%= link_to "Cancelar", admin_people_path, class: "btn btn-secondary" %>
        <%= f.submit "Criar colaborador", class: "btn btn-primary" %>
      </div>
    <% end %>
  </main>
</div>

<script>
  function previewAvatar(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      const preview = document.getElementById('avatar-preview');
      preview.innerHTML = '';
      preview.style.border = 'none';
      const img = document.createElement('img');
      img.src = e.target.result;
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:50%;';
      preview.appendChild(img);
    };
    reader.readAsDataURL(input.files[0]);
  }

  document.addEventListener("DOMContentLoaded", function() {
    const checked = document.querySelector('input[name="person[role]"]:checked');
    if (checked) checked.closest('.role-card').style.borderColor = 'var(--color-accent)';
  });
</script>
