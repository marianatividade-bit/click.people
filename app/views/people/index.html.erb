<% content_for :title, "Pessoas — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "people" %>

  <main class="app-content">
    <h1 class="page-title">Pessoas</h1>
    <p class="page-subtitle"><%= @people.count %> colaborador<%= @people.count == 1 ? "" : "es" %> cadastrado<%= @people.count == 1 ? "" : "s" %>.</p>

    <% if @people.empty? %>
      <div class="card" style="text-align:center; padding: 48px 24px;">
        <p style="font-size:15px; color:var(--color-text-secondary); margin:0;">Nenhuma pessoa cadastrada ainda. O cadastro acontece automaticamente no primeiro login via Google.</p>
      </div>
    <% else %>
      <div style="display:flex; flex-direction:column; gap:2px;">
        <% @people.each do |person| %>
          <%= link_to person_path(person), style: "text-decoration:none;" do %>
            <div class="card" style="display:flex; align-items:center; gap:16px; padding:16px 20px; border-radius:8px;">
              <div style="width:36px; height:36px; border-radius:50%; background:var(--color-accent); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:14px; flex-shrink:0;">
                <%= person.name.split(" ").first(2).map { |n| n[0] }.join %>
              </div>
              <div style="flex:1;">
                <div style="font-size:15px; font-weight:600; color:var(--color-text);"><%= person.name %></div>
                <div style="font-size:13px; color:var(--color-text-secondary);"><%= person.email %></div>
              </div>
              <span style="font-size:12px; color:var(--color-text-secondary); text-transform:capitalize;"><%= person.role.humanize %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
