<% content_for :title, "#{@person.name} — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "people" %>

  <main class="app-content">
    <%= link_to "← Pessoas", people_path, style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <%# Header do perfil %>
    <div style="display:flex;align-items:center;gap:20px;margin-bottom:32px;">
      <div style="width:64px;height:64px;border-radius:50%;background:var(--color-accent);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:22px;flex-shrink:0;">
        <%= @person.name.split(" ").first(2).map{|n|n[0]}.join %>
      </div>
      <div>
        <h1 style="font-size:22px;font-weight:700;margin:0 0 2px;"><%= @person.name %></h1>
        <div style="font-size:14px;color:var(--color-text-secondary);"><%= @person.email %></div>
        <div style="margin-top:6px;">
          <span class="cycle-badge" style="background:rgba(255,87,34,0.1);color:var(--color-accent);">
            <%= @person.role.humanize %>
          </span>
          <span class="cycle-badge cycle-badge--<%= @person.active? ? 'open' : 'closed' %>" style="margin-left:6px;">
            <%= @person.active? ? "Ativo" : "Inativo" %>
          </span>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:32px;">
      <%# Liderança %>
      <div class="card">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:var(--color-text-secondary);margin-bottom:12px;">Liderança</div>
        <div style="margin-bottom:10px;">
          <div style="font-size:12px;color:var(--color-text-secondary);margin-bottom:2px;">Chapter Manager</div>
          <div style="font-size:14px;font-weight:600;">
            <%= @person.chapter_manager&.name || "—" %>
          </div>
        </div>
        <div>
          <div style="font-size:12px;color:var(--color-text-secondary);margin-bottom:2px;">Stream Manager</div>
          <div style="font-size:14px;font-weight:600;">
            <%= @person.stream_manager&.name || "—" %>
          </div>
        </div>
      </div>

      <%# Avaliações recentes %>
      <div class="card">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:var(--color-text-secondary);margin-bottom:12px;">Avaliações recentes</div>
        <% recent = Evaluation.for_evaluated(@person).submitted.includes(:cycle).order(submitted_at: :desc).limit(3) %>
        <% if recent.any? %>
          <% recent.each do |ev| %>
            <div style="font-size:13px;margin-bottom:6px;display:flex;justify-content:space-between;">
              <span><%= ev.cycle.name %></span>
              <span style="color:var(--color-text-secondary);">
                P: <%= ev.performance_score&.round(1) || "—" %> · Pot: <%= ev.potential_score&.round(1) || "—" %>
              </span>
            </div>
          <% end %>
        <% else %>
          <div style="font-size:13px;color:var(--color-text-secondary);">Nenhuma avaliação ainda.</div>
        <% end %>
      </div>
    </div>

    <%# Time do manager %>
    <% reports = @person.chapter_reports.order(:name) %>
    <% if reports.any? %>
      <h2 style="font-size:16px;font-weight:700;margin:0 0 12px;">Time de chapter (<%= reports.count %>)</h2>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <% reports.each do |member| %>
          <%= link_to person_path(member), style: "text-decoration:none;" do %>
            <div class="card" style="display:flex;align-items:center;gap:12px;padding:12px 16px;">
              <div style="width:32px;height:32px;border-radius:50%;background:var(--color-surface-alt);border:1px solid var(--color-border);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--color-text-secondary);">
                <%= member.name.split(" ").first(2).map{|n|n[0]}.join %>
              </div>
              <div>
                <div style="font-size:14px;font-weight:600;color:var(--color-text);"><%= member.name %></div>
                <div style="font-size:12px;color:var(--color-text-secondary);"><%= member.role.humanize %></div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
