<% content_for :title, "Configurar 9-Box — #{@cycle.name}" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "ninebox" %>

  <main class="app-content">
    <%= link_to "← 9-Box", cycle_nine_box_path(@cycle), style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>
    <h1 class="page-title">Configurar 9-Box</h1>
    <p class="page-subtitle"><%= @cycle.name %> — defina os nomes e eixos do grid.</p>

    <%= form_with url: cycle_nine_box_path(@cycle), method: :patch, local: true do |f| %>
      <div class="card" style="max-width:640px;margin-bottom:16px;">
        <div style="font-size:13px;font-weight:600;margin-bottom:16px;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:0.5px;">Eixos</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-field" style="margin-bottom:0;">
            <label class="form-label">Eixo X (horizontal)</label>
            <input type="text" name="nine_box[axis_x_label]" value="<%= @config['axis_x_label'] %>" class="form-input" placeholder="Desempenho">
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <label class="form-label">Eixo Y (vertical)</label>
            <input type="text" name="nine_box[axis_y_label]" value="<%= @config['axis_y_label'] %>" class="form-input" placeholder="Potencial">
          </div>
        </div>
      </div>

      <div class="card" style="max-width:640px;margin-bottom:24px;">
        <div style="font-size:13px;font-weight:600;margin-bottom:16px;color:var(--color-text-secondary);text-transform:uppercase;letter-spacing:0.5px;">Nomes dos quadrantes</div>

        <%# Grid visual para editar os nomes na posição certa %>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
          <% [[6,7,8],[3,4,5],[0,1,2]].each do |row| %>
            <% row.each do |i| %>
              <div>
                <label style="font-size:11px;color:var(--color-text-secondary);display:block;margin-bottom:4px;">
                  Quadrante <%= i+1 %>
                </label>
                <input type="text" name="nine_box[quadrant_names][]"
                       value="<%= @names[i] %>"
                       class="form-input"
                       style="font-size:13px;padding:8px 10px;"
                       data-idx="<%= i %>">
              </div>
            <% end %>
          <% end %>
        </div>
        <p style="font-size:12px;color:var(--color-text-secondary);margin:12px 0 0;">A ordem dos campos segue o grid: linha de cima (alto potencial) → linha do meio → linha de baixo.</p>
      </div>

      <div style="display:flex;gap:12px;">
        <%= f.submit "Salvar configuração", class: "btn btn-primary" %>
        <%= link_to "Cancelar", cycle_nine_box_path(@cycle), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </main>
</div>
