<% content_for :title, "Configurar #{@cycle.name} — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "cycles" %>

  <main class="app-content">
    <%= link_to "← #{@cycle.name}", cycle_path(@cycle), style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;">
      <div>
        <h1 class="page-title" style="margin-bottom:4px;">Configurar ciclo</h1>
        <p class="page-subtitle" style="margin:0;"><%= @cycle.name %> · <span class="cycle-badge cycle-badge--<%= @cycle.status %>"><%= @cycle.current_phase_label %></span></p>
      </div>
    </div>

    <%# Tabs %>
    <% tabs = [
      { key: "geral",         label: "Geral" },
      { key: "cronograma",    label: "Cronograma" },
      { key: "perguntas",     label: "Perguntas" },
      { key: "participantes", label: "Participantes" },
      { key: "nine_box",      label: "9-Box" },
    ] %>

    <div style="display:flex;gap:0;border-bottom:2px solid var(--color-border);margin-bottom:24px;">
      <% tabs.each do |tab| %>
        <% active = @tab == tab[:key] %>
        <%= link_to configure_cycle_path(@cycle, tab: tab[:key]),
              style: "font-size:14px;font-weight:#{active ? '700' : '500'};color:#{active ? 'var(--color-accent)' : 'var(--color-text-secondary)'};text-decoration:none;padding:10px 20px;border-bottom:2px solid #{active ? 'var(--color-accent)' : 'transparent'};margin-bottom:-2px;" do %>
          <%= tab[:label] %>
        <% end %>
      <% end %>
    </div>

    <%# Flash %>
    <% if notice %>
      <div style="margin-bottom:16px;padding:12px 16px;background:#f0fdf4;border-left:3px solid #22c55e;border-radius:var(--radius-md);">
        <p style="margin:0;font-size:13px;color:#15803d;"><%= notice %></p>
      </div>
    <% end %>
    <% if alert %>
      <div style="margin-bottom:16px;padding:12px 16px;background:#fff5f5;border-left:3px solid #e53e3e;border-radius:var(--radius-md);">
        <p style="margin:0;font-size:13px;color:#c53030;"><%= alert %></p>
      </div>
    <% end %>

    <%# ── ABA GERAL ── %>
    <% if @tab == "geral" %>
      <%= form_with url: configure_cycle_path(@cycle), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :tab, "geral" %>
        <div class="card" style="max-width:560px;">
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 20px;">Informações gerais</p>

          <div class="form-field">
            <label class="form-label">Nome do ciclo</label>
            <input type="text" name="cycle[name]" value="<%= @cycle.name %>" class="form-input">
          </div>

          <div class="form-field">
            <label class="form-label">Descrição</label>
            <textarea name="cycle[description]" class="form-input" rows="2"><%= @cycle.description %></textarea>
          </div>

          <div class="form-field" style="margin-bottom:0;">
            <label class="form-label">Máximo de indicações por colaborador</label>
            <input type="number" name="cycle[max_peer_nominations]" value="<%= @cycle.max_peer_nominations %>" class="form-input" min="1" max="20" style="max-width:100px;">
            <p style="margin:4px 0 0;font-size:12px;color:var(--color-text-secondary);">Quantos pares cada colaborador pode indicar</p>
          </div>
        </div>

        <div style="margin-top:20px;">
          <input type="submit" value="Salvar" class="btn btn-primary">
        </div>
      <% end %>
    <% end %>

    <%# ── ABA CRONOGRAMA ── %>
    <% if @tab == "cronograma" %>
      <%= form_with url: configure_cycle_path(@cycle), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :tab, "cronograma" %>
        <div class="card" style="max-width:600px;">
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 20px;">Datas das etapas</p>
          <p style="font-size:13px;color:var(--color-text-secondary);margin:0 0 24px;">Defina o período de cada fase do ciclo. As datas servem como referência visual — o avanço entre fases é feito manualmente.</p>

          <% [
            ["Indicações de pares",      "nominations_start", "nominations_end",  @cycle.nominations_start, @cycle.nominations_end],
            ["Validação de indicações",  "validations_start", "validations_end",  @cycle.validations_start, @cycle.validations_end],
            ["Avaliações",               "evaluation_start",  "evaluation_end",   @cycle.evaluation_start,  @cycle.evaluation_end],
            ["Calibração",               "calibration_start", "calibration_end",  @cycle.calibration_start, @cycle.calibration_end],
          ].each do |phase_label, start_key, end_key, start_val, end_val| %>
            <div style="margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--color-border);">
              <p style="font-size:13px;font-weight:600;margin:0 0 10px;"><%= phase_label %></p>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div>
                  <label class="form-label" style="font-size:11px;">Início</label>
                  <input type="datetime-local" name="cycle[<%= start_key %>]"
                         value="<%= start_val&.strftime('%Y-%m-%dT%H:%M') %>"
                         class="form-input">
                </div>
                <div>
                  <label class="form-label" style="font-size:11px;">Fim</label>
                  <input type="datetime-local" name="cycle[<%= end_key %>]"
                         value="<%= end_val&.strftime('%Y-%m-%dT%H:%M') %>"
                         class="form-input">
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <div style="margin-top:20px;">
          <input type="submit" value="Salvar cronograma" class="btn btn-primary">
        </div>
      <% end %>
    <% end %>

    <%# ── ABA PERGUNTAS ── %>
    <% if @tab == "perguntas" %>
      <div style="max-width:700px;">

        <% if @questions.any? %>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:24px;">
            <% @questions.each_with_index do |q, i| %>
              <div class="card" style="padding:16px;" id="question-<%= q.id %>">
                <div style="display:flex;align-items:flex-start;gap:12px;">
                  <%# Reorder buttons %>
                  <div style="display:flex;flex-direction:column;gap:2px;flex-shrink:0;margin-top:4px;">
                    <% if i > 0 %>
                      <%= button_to "↑", reorder_question_path(q), params: { direction: "up" },
                            method: :patch,
                            style: "width:24px;height:22px;font-size:12px;background:var(--color-surface-alt);border:1px solid var(--color-border);border-radius:4px;cursor:pointer;display:flex;align-items:center;justify-content:center;" %>
                    <% else %>
                      <div style="width:24px;height:22px;"></div>
                    <% end %>
                    <% if i < @questions.length - 1 %>
                      <%= button_to "↓", reorder_question_path(q), params: { direction: "down" },
                            method: :patch,
                            style: "width:24px;height:22px;font-size:12px;background:var(--color-surface-alt);border:1px solid var(--color-border);border-radius:4px;cursor:pointer;display:flex;align-items:center;justify-content:center;" %>
                    <% else %>
                      <div style="width:24px;height:22px;"></div>
                    <% end %>
                  </div>

                  <div style="width:24px;height:24px;border-radius:50%;background:var(--color-surface-alt);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--color-text-secondary);flex-shrink:0;margin-top:2px;"><%= i + 1 %></div>

                  <div style="flex:1;">
                    <%# Display mode %>
                    <div id="question-display-<%= q.id %>">
                      <div style="font-size:14px;font-weight:600;margin-bottom:4px;"><%= q.text %></div>
                      <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <span style="font-size:11px;font-weight:600;background:var(--color-surface-alt);border-radius:var(--radius-pill);padding:2px 8px;color:var(--color-text-secondary);"><%= q.dimension_label %></span>
                        <% if q.numeric? %>
                          <span style="font-size:11px;color:var(--color-text-secondary);">Nota <%= q.min_score %>–<%= q.max_score %></span>
                        <% else %>
                          <span style="font-size:11px;color:var(--color-text-secondary);">Texto livre</span>
                        <% end %>
                        <span style="font-size:11px;color:var(--color-text-secondary);">Avaliador: <%= q.evaluator_types == "manager" ? "Só gestores" : q.evaluator_types == "peer" ? "Só pares" : "Todos" %></span>
                      </div>
                    </div>

                    <%# Edit mode (hidden) %>
                    <div id="question-edit-<%= q.id %>" style="display:none;">
                      <%= form_with url: question_path(q), method: :patch, local: true do |f| %>
                        <div class="form-field">
                          <%= f.text_area :text, value: q.text, class: "form-input", rows: 2, name: "question[text]" %>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:8px;">
                          <select name="question[dimension]" class="form-input">
                            <% [["resultado","Resultado"],["atitude","Atitude"],["open","Pergunta aberta"],["next_steps","Próximos passos"]].each do |val, lbl| %>
                              <option value="<%= val %>" <%= q.dimension == val ? "selected" : "" %>><%= lbl %></option>
                            <% end %>
                          </select>
                          <select name="question[answer_type]" class="form-input">
                            <option value="0" <%= q.numeric? ? "selected" : "" %>>Nota numérica</option>
                            <option value="1" <%= q.text? ? "selected" : "" %>>Texto livre</option>
                          </select>
                          <select name="question[evaluator_types]" class="form-input">
                            <option value="all"     <%= q.evaluator_types == "all"     ? "selected" : "" %>>Todos</option>
                            <option value="manager" <%= q.evaluator_types == "manager" ? "selected" : "" %>>Só gestores</option>
                            <option value="peer"    <%= q.evaluator_types == "peer"    ? "selected" : "" %>>Só pares</option>
                          </select>
                        </div>
                        <div style="display:flex;gap:8px;">
                          <input type="submit" value="Salvar" class="btn btn-primary" style="font-size:12px;padding:5px 14px;">
                          <button type="button" onclick="toggleQuestionEdit('<%= q.id %>', false)" class="btn btn-secondary" style="font-size:12px;padding:5px 14px;">Cancelar</button>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div style="display:flex;gap:4px;flex-shrink:0;">
                    <button type="button" onclick="toggleQuestionEdit('<%= q.id %>', true)"
                            style="font-size:12px;color:var(--color-accent);background:none;border:none;cursor:pointer;padding:4px 8px;font-weight:600;">
                      Editar
                    </button>
                    <%= button_to "Remover", cycle_question_path(@cycle, q),
                          method: :delete,
                          style: "font-size:12px;color:#e53e3e;background:none;border:none;cursor:pointer;padding:4px 8px;",
                          data: { confirm: "Remover esta pergunta?" } %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card" style="text-align:center;padding:32px;margin-bottom:24px;">
            <p style="color:var(--color-text-secondary);margin:0;font-size:13px;">Nenhuma pergunta configurada. Adicione abaixo.</p>
          </div>
        <% end %>

        <%# Add question form %>
        <div class="card">
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 16px;">Adicionar pergunta</p>
          <%= form_with url: cycle_questions_path(@cycle), method: :post, local: true do |f| %>

            <div class="form-field">
              <label class="form-label">Texto da pergunta</label>
              <%= f.text_area :question, name: "question[text]", class: "form-input", rows: 2,
                    placeholder: "Ex: Como você avalia a entrega de resultados deste colaborador?" %>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div class="form-field">
                <label class="form-label">Dimensão</label>
                <select name="question[dimension]" class="form-input">
                  <option value="resultado">Resultado</option>
                  <option value="atitude">Atitude</option>
                  <option value="open">Pergunta aberta</option>
                  <option value="next_steps">Próximos passos</option>
                </select>
              </div>

              <div class="form-field">
                <label class="form-label">Tipo de resposta</label>
                <select name="question[answer_type]" class="form-input" onchange="toggleScoreFields(this)">
                  <option value="0">Nota numérica</option>
                  <option value="1">Texto livre</option>
                </select>
              </div>
            </div>

            <div id="score-fields" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
              <div class="form-field">
                <label class="form-label">Nota mínima</label>
                <input type="number" name="question[min_score]" value="1" class="form-input" min="0" max="10">
              </div>
              <div class="form-field">
                <label class="form-label">Nota máxima</label>
                <input type="number" name="question[max_score]" value="10" class="form-input" min="1" max="10">
              </div>
              <div class="form-field" style="margin-bottom:0;">
                <label class="form-label">Quem responde</label>
                <select name="question[evaluator_types]" class="form-input">
                  <option value="all">Todos</option>
                  <option value="manager">Só gestores</option>
                  <option value="peer">Só pares</option>
                </select>
              </div>
            </div>

            <input type="submit" value="Adicionar pergunta" class="btn btn-primary" style="margin-top:8px;">
          <% end %>
        </div>
      </div>

      <script>
        function toggleScoreFields(sel) {
          document.getElementById('score-fields').style.display = sel.value === '1' ? 'none' : 'grid';
        }
        function toggleQuestionEdit(id, show) {
          document.getElementById('question-display-' + id).style.display = show ? 'none' : 'block';
          document.getElementById('question-edit-' + id).style.display   = show ? 'block' : 'none';
        }
      </script>
    <% end %>

    <%# ── ABA PARTICIPANTES ── %>
    <% if @tab == "participantes" %>
      <%# Contador de resumo %>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
        <p style="font-size:13px;color:var(--color-text-secondary);margin:0;">
          <strong style="color:var(--color-text);"><%= @evaluated_people.size %></strong> pessoas no ciclo
        </p>
      </div>

      <%# Barra de ações %>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:12px;flex-wrap:wrap;">
        <%# Adicionar pessoa individual %>
        <%= form_with url: cycle_evaluation_plans_path(@cycle), method: :post, local: true,
              style: "display:flex;gap:8px;align-items:center;flex:1;min-width:300px;" do |f| %>
          <select name="evaluated_id" class="form-input" style="flex:1;font-size:13px;">
            <option value="">Adicionar pessoa ao ciclo…</option>
            <% @people_not_in_cycle.each do |p| %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% end %>
          </select>
          <button type="submit" class="btn btn-secondary" style="font-size:13px;white-space:nowrap;flex-shrink:0;">+ Adicionar</button>
        <% end %>

        <%# Importar toda a hierarquia %>
        <%= button_to "Importar hierarquia",
              bulk_add_cycle_evaluation_plans_path(@cycle),
              method: :post,
              class: "btn btn-primary",
              style: "font-size:13px;white-space:nowrap;flex-shrink:0;",
              data: { confirm: "Preencher com todos os colaboradores ativos e seus gestores/liderados? Relações já existentes não serão duplicadas." } %>
      </div>

      <%# Tabela agrupada por avaliado %>
      <div class="card" style="padding:0;overflow:hidden;">
        <% if @evaluated_people.any? %>
          <table style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:2px solid var(--color-border);">
                <th style="text-align:left;padding:11px 20px;font-size:12px;font-weight:600;color:var(--color-text-secondary);letter-spacing:0.3px;width:240px;">Avaliado</th>
                <th style="text-align:left;padding:11px 20px;font-size:12px;font-weight:600;color:var(--color-text-secondary);letter-spacing:0.3px;width:220px;">Gestor(es)</th>
                <th style="text-align:left;padding:11px 20px;font-size:12px;font-weight:600;color:var(--color-text-secondary);letter-spacing:0.3px;">Outros avaliadores</th>
                <th style="padding:11px 20px;width:40px;"></th>
              </tr>
            </thead>
            <tbody>
              <% @evaluated_people.each do |evaluated| %>
                <% plans = @plans_by_evaluated[evaluated.id] || [] %>
                <% gestores  = plans.select(&:manager_type?) %>
                <% liderados = plans.select(&:direct_report?) %>
                <% noms      = @nominations_by_nominator[evaluated.id] || [] %>

                <tr class="cycle-table-row" style="border-bottom:1px solid var(--color-border);vertical-align:top;">

                  <%# ── Avaliado ── %>
                  <td style="padding:16px 20px;">
                    <div style="display:flex;align-items:center;gap:10px;">
                      <%= person_avatar(evaluated, size: 34, font_size: 13) %>
                      <div>
                        <div style="font-size:13px;font-weight:600;line-height:1.3;"><%= evaluated.name %></div>
                        <div style="font-size:11px;color:var(--color-text-secondary);"><%= evaluated.email %></div>
                      </div>
                    </div>
                  </td>

                  <%# ── Gestor(es) ── %>
                  <td style="padding:16px 20px;">
                    <% if gestores.any? %>
                      <div style="display:flex;flex-direction:column;gap:5px;">
                        <% gestores.each do |plan| %>
                          <div style="display:inline-flex;align-items:center;gap:7px;background:var(--color-surface-alt);border-radius:var(--radius-pill);padding:5px 10px 5px 5px;width:fit-content;max-width:200px;">
                            <%= person_avatar(plan.evaluator, size: 24, font_size: 9) %>
                            <span style="font-size:12px;font-weight:500;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= plan.evaluator.name %>">
                              <%= plan.evaluator.name %>
                            </span>
                            <span style="font-size:10px;font-weight:700;border-radius:var(--radius-pill);padding:1px 5px;flex-shrink:0;
                                  <%= plan.chapter_manager? ? 'background:#dbeafe;color:#1e3a5f;' : 'background:#dcfce7;color:#14532d;' %>">
                              <%= plan.chapter_manager? ? "Cap." : "Stream" %>
                            </span>
                            <%= button_to cycle_evaluation_plan_path(@cycle, plan), method: :delete,
                                  style: "background:none;border:none;cursor:pointer;padding:0;flex-shrink:0;color:var(--color-text-secondary);line-height:1;",
                                  data: { confirm: "Remover #{plan.evaluator.name} como gestor?" },
                                  title: "Remover" do %>
                              <svg width="11" height="11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% else %>
                      <span style="font-size:12px;color:var(--color-text-secondary);">Sem gestor na hierarquia</span>
                    <% end %>
                  </td>

                  <%# ── Outros avaliadores ── %>
                  <td style="padding:16px 20px;">
                    <% has_others = liderados.any? || noms.any? %>
                    <% if has_others %>
                      <div style="display:flex;flex-direction:column;gap:10px;">

                        <%# Liderados (avaliação ascendente via hierarquia) %>
                        <% if liderados.any? %>
                          <div>
                            <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 5px;">Liderados</p>
                            <div style="display:flex;flex-wrap:wrap;gap:4px;">
                              <% liderados.each do |plan| %>
                                <div style="display:inline-flex;align-items:center;gap:5px;background:var(--color-surface-alt);border-radius:var(--radius-pill);padding:4px 8px 4px 4px;">
                                  <%= person_avatar(plan.evaluator, size: 22, font_size: 9) %>
                                  <span style="font-size:12px;font-weight:500;white-space:nowrap;"><%= plan.evaluator.name.split.first %></span>
                                  <%= button_to cycle_evaluation_plan_path(@cycle, plan), method: :delete,
                                        style: "background:none;border:none;cursor:pointer;padding:0;flex-shrink:0;color:var(--color-text-secondary);line-height:1;",
                                        data: { confirm: "Remover #{plan.evaluator.name.split.first}?" },
                                        title: "Remover" do %>
                                    <svg width="10" height="10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                  <% end %>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        <% end %>

                        <%# Pares (indicações aprovadas) %>
                        <% if noms.any? %>
                          <div>
                            <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 5px;">Pares</p>
                            <div style="display:flex;flex-wrap:wrap;gap:4px;">
                              <% noms.each do |nom| %>
                                <div style="display:inline-flex;align-items:center;gap:5px;background:#fef9ec;border:1px solid #fde68a;border-radius:var(--radius-pill);padding:4px 10px 4px 4px;" title="Indicação aprovada">
                                  <%= person_avatar(nom.nominated, size: 22, font_size: 9) %>
                                  <span style="font-size:12px;font-weight:500;color:#92400e;white-space:nowrap;"><%= nom.nominated.name.split.first %></span>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        <% end %>

                      </div>
                    <% else %>
                      <span style="font-size:12px;color:var(--color-text-secondary);">—</span>
                    <% end %>
                  </td>

                  <%# ── Remover do ciclo ── %>
                  <td style="padding:16px 20px;">
                    <div class="icon-action-wrap" title="Remover do ciclo">
                      <%= button_to remove_evaluated_cycle_evaluation_plans_path(@cycle),
                            method: :delete,
                            params: { evaluated_id: evaluated.id },
                            class: "icon-action icon-action--danger",
                            data: { confirm: "Remover #{evaluated.name} do ciclo? Todos os avaliadores desta pessoa serão desvinculados." } do %>
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <polyline points="3 6 5 6 21 6"/>
                          <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                          <path d="M10 11v6M14 11v6M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"/>
                        </svg>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

        <% else %>
          <%# Empty state %>
          <div style="text-align:center;padding:56px 24px;">
            <div style="width:52px;height:52px;border-radius:50%;background:var(--color-surface-alt);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
              <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="var(--color-text-secondary)" stroke-width="1.5">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
              </svg>
            </div>
            <p style="font-size:14px;font-weight:600;margin:0 0 6px;">Nenhuma pessoa no ciclo</p>
            <p style="font-size:13px;color:var(--color-text-secondary);margin:0 0 20px;max-width:360px;margin-left:auto;margin-right:auto;">
              Clique em "Importar hierarquia" para incluir todos os colaboradores ativos com seus gestores e liderados automaticamente.
            </p>
            <%= button_to "Importar hierarquia",
                  bulk_add_cycle_evaluation_plans_path(@cycle),
                  method: :post,
                  class: "btn btn-primary",
                  data: { confirm: "Importar toda a hierarquia atual?" } %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# ── ABA 9-BOX ── %>
    <% if @tab == "nine_box" %>
      <% cfg = @cycle.nine_box_config || {} %>
      <%= form_with url: configure_cycle_path(@cycle), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :tab, "nine_box" %>
        <div class="card" style="max-width:560px;">
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--color-text-secondary);margin:0 0 20px;">Configuração do 9-Box</p>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
            <div class="form-field" style="margin-bottom:0;">
              <label class="form-label">Eixo X — Label (horizontal)</label>
              <input type="text" name="nine_box[axis_x_label]"
                     value="<%= cfg['axis_x_label'] || 'Performance' %>"
                     class="form-input" placeholder="Performance">
            </div>
            <div class="form-field" style="margin-bottom:0;">
              <label class="form-label">Eixo Y — Label (vertical)</label>
              <input type="text" name="nine_box[axis_y_label]"
                     value="<%= cfg['axis_y_label'] || 'Potencial' %>"
                     class="form-input" placeholder="Potencial">
            </div>
          </div>

          <p style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin:0 0 12px;text-transform:uppercase;letter-spacing:0.4px;">Cortes do eixo X (Performance)</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
            <div class="form-field" style="margin-bottom:0;">
              <label class="form-label">Corte baixo (abaixo = baixo)</label>
              <input type="number" name="nine_box[x_low]" step="0.1" min="1" max="10"
                     value="<%= (cfg['axis_x_thresholds'] || [4.0, 7.0])[0] %>" class="form-input">
            </div>
            <div class="form-field" style="margin-bottom:0;">
              <label class="form-label">Corte alto (acima = alto)</label>
              <input type="number" name="nine_box[x_high]" step="0.1" min="1" max="10"
                     value="<%= (cfg['axis_x_thresholds'] || [4.0, 7.0])[1] %>" class="form-input">
            </div>
          </div>

          <p style="font-size:12px;font-weight:600;color:var(--color-text-secondary);margin:0 0 12px;text-transform:uppercase;letter-spacing:0.4px;">Cortes do eixo Y (Potencial)</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:0;">
            <div class="form-field" style="margin-bottom:0;">
              <label class="form-label">Corte baixo</label>
              <input type="number" name="nine_box[y_low]" step="0.1" min="1" max="10"
                     value="<%= (cfg['axis_y_thresholds'] || [4.0, 7.0])[0] %>" class="form-input">
            </div>
            <div class="form-field" style="margin-bottom:0;">
              <label class="form-label">Corte alto</label>
              <input type="number" name="nine_box[y_high]" step="0.1" min="1" max="10"
                     value="<%= (cfg['axis_y_thresholds'] || [4.0, 7.0])[1] %>" class="form-input">
            </div>
          </div>
        </div>

        <div style="margin-top:20px;">
          <input type="submit" value="Salvar configuração 9-Box" class="btn btn-primary">
        </div>
      <% end %>
    <% end %>

  </main>
</div>
