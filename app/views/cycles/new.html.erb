<% content_for :title, "Novo Ciclo — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "cycles" %>

  <main class="app-content">
    <%= link_to "← Ciclos", cycles_path, style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <h1 class="page-title" style="margin-bottom:4px;">Novo ciclo de avaliação</h1>
    <p class="page-subtitle" style="margin:0 0 28px;">Dê um nome ao ciclo — você configurará as datas e perguntas na próxima etapa.</p>

    <div class="card" style="max-width:480px;">
      <%= form_with model: @cycle, local: true do |f| %>
        <% if @cycle.errors.any? %>
          <div style="margin-bottom:16px;padding:12px 16px;background:#fff5f5;border-left:3px solid #e53e3e;border-radius:var(--radius-md);">
            <p style="margin:0;font-size:13px;color:#c53030;"><%= @cycle.errors.full_messages.first %></p>
          </div>
        <% end %>

        <div class="form-field">
          <%= f.label :name, "Nome do ciclo", class: "form-label" %>
          <%= f.text_field :name, class: "form-input", placeholder: "Ex: Avaliação 2026.1", autofocus: true %>
          <p style="margin:4px 0 0;font-size:12px;color:var(--color-text-secondary);">Semestral: use o formato Ano.Semestre (ex: 2026.1)</p>
        </div>

        <div class="form-field" style="margin-bottom:0;">
          <%= f.label :description, "Descrição (opcional)", class: "form-label" %>
          <%= f.text_area :description, class: "form-input", rows: 2, placeholder: "Contexto sobre este ciclo..." %>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
          <%= f.submit "Criar e configurar →", class: "btn btn-primary" %>
          <%= link_to "Cancelar", cycles_path, class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </main>
</div>
