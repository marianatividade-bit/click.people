<% content_for :title, "Novo Ciclo — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "cycles" %>

  <main class="app-content">
    <%= link_to "← Ciclos", cycles_path, style: "font-size:14px; color:var(--color-text-secondary); text-decoration:none; display:inline-block; margin-bottom:24px;" %>

    <h1 class="page-title">Novo ciclo</h1>
    <p class="page-subtitle">Configure o próximo ciclo de avaliação.</p>

    <div class="card" style="max-width:520px;">
      <%= form_with model: @cycle, local: true do |f| %>
        <% if @cycle.errors.any? %>
          <div class="flash flash--alert" style="margin-bottom:20px; border-radius:var(--radius-input);">
            <%= @cycle.errors.full_messages.first %>
          </div>
        <% end %>

        <div class="form-field">
          <%= f.label :name, "Nome do ciclo", class: "form-label" %>
          <%= f.text_field :name, placeholder: "Ex: Avaliação 2026.1", class: "form-input" %>
        </div>

        <div class="form-field">
          <%= f.label :evaluation_deadline, "Prazo das avaliações", class: "form-label" %>
          <%= f.date_field :evaluation_deadline, class: "form-input" %>
        </div>

        <div style="margin-top:28px;">
          <%= f.submit "Criar ciclo", class: "btn btn-primary" %>
          <%= link_to "Cancelar", cycles_path, class: "btn btn-secondary", style: "margin-left:12px;" %>
        </div>
      <% end %>
    </div>
  </main>
</div>
