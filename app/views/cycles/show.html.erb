<% content_for :title, "#{@cycle.name} — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "cycles" %>

  <main class="app-content">
    <%= link_to "← Ciclos", cycles_path, style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <%# Header %>
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
      <div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:4px;">
          <h1 class="page-title" style="margin-bottom:0;"><%= @cycle.name %></h1>
          <span class="cycle-badge cycle-badge--<%= @cycle.status %>"><%= @cycle.current_phase_label %></span>
        </div>
        <% if @cycle.description.present? %>
          <p class="page-subtitle" style="margin:0;"><%= @cycle.description %></p>
        <% end %>
      </div>
      <div style="display:flex;gap:8px;">
        <% if @cycle.draft? %>
          <%= button_to "Excluir", cycle_path(@cycle),
                method: :delete,
                style: "font-size:13px;font-weight:600;background:none;color:#e53e3e;border:1px solid #e53e3e;padding:8px 16px;border-radius:var(--radius-pill);cursor:pointer;",
                data: { confirm: "Excluir o ciclo \"#{@cycle.name}\" permanentemente?" } %>
        <% end %>
        <% if @cycle.closed? %>
          <%= button_to "Duplicar ciclo", duplicate_cycle_path(@cycle),
                method: :patch,
                style: "font-size:13px;font-weight:600;background:none;color:var(--color-text-secondary);border:1px solid var(--color-border);padding:8px 16px;border-radius:var(--radius-pill);cursor:pointer;" %>
        <% end %>
        <%= link_to "Configurar", configure_cycle_path(@cycle), style: "font-size:13px;font-weight:600;color:var(--color-text-secondary);text-decoration:none;padding:8px 16px;border:1px solid var(--color-border);border-radius:var(--radius-pill);" %>
        <% unless @cycle.closed? %>
          <%= button_to "Avançar fase →", advance_cycle_path(@cycle),
                method: :patch,
                style: "font-size:13px;font-weight:600;background:var(--color-accent);color:#fff;border:none;padding:8px 16px;border-radius:var(--radius-pill);cursor:pointer;",
                data: { confirm: "Confirma avançar o ciclo para a próxima fase?" } %>
        <% end %>
      </div>
    </div>

    <%# Stats row %>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:28px;">
      <% [
        ["Participantes", @stats[:participants]],
        ["Perguntas",     @stats[:questions]],
        ["Indicações",    @stats[:nominations]],
        ["Avaliações",    "#{@stats[:completed]}/#{@stats[:evaluations]}"],
      ].each do |label, value| %>
        <div class="card" style="padding:16px;text-align:center;">
          <div style="font-size:22px;font-weight:700;color:var(--color-text);"><%= value %></div>
          <div style="font-size:12px;color:var(--color-text-secondary);margin-top:2px;"><%= label %></div>
        </div>
      <% end %>
    </div>

    <%# Phase cards %>
    <h2 style="font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--color-text-secondary);margin:0 0 14px;">Etapas do ciclo</h2>

    <% phases = [
      {
        key:   "nominations_open",
        label: "Indicações de pares",
        desc:  "Colaboradores indicam colegas para avaliar",
        icon:  "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0",
        start: @cycle.nominations_start,
        end:   @cycle.nominations_end,
        stat:  "#{@cycle.nominations.count} indicações",
      },
      {
        key:   "validating",
        label: "Validação de indicações",
        desc:  "Gestores aprovam ou rejeitam indicações",
        icon:  "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
        start: @cycle.validations_start,
        end:   @cycle.validations_end,
        stat:  "#{@cycle.nominations.where(status: :approved).count} aprovadas",
      },
      {
        key:   "evaluation_open",
        label: "Responder avaliações",
        desc:  "Autoavaliação, gestores e pares respondem",
        icon:  "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z",
        start: @cycle.evaluation_start,
        end:   @cycle.evaluation_end,
        stat:  "#{@stats[:completed]}/#{@stats[:evaluations]} concluídas",
      },
      {
        key:   "calibration",
        label: "Calibração",
        desc:  "RH ajusta posicionamentos no 9-Box",
        icon:  "M3 4a1 1 0 00-1 1v14a1 1 0 001 1h18a1 1 0 001-1V5a1 1 0 00-1-1H3zm0 0h18M3 10h18",
        start: @cycle.calibration_start,
        end:   @cycle.calibration_end,
        stat:  "#{@cycle.cycle_results.where(is_calibrated: true).count} calibrados",
      },
      {
        key:   "closed",
        label: "Resultados e relatórios",
        desc:  "9-Box final e relatórios individuais disponíveis",
        icon:  "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
        start: nil,
        end:   nil,
        stat:  "#{@cycle.cycle_results.count} resultados",
      },
    ]

    status_order = %w[draft nominations_open validating evaluation_open calibration closed]
    current_idx  = status_order.index(@cycle.status) || 0
    %>

    <div style="display:flex;flex-direction:column;gap:10px;">
      <% phases.each_with_index do |phase, i| %>
        <% phase_idx = i + 1 %>
        <% is_active    = @cycle.status == phase[:key] %>
        <% is_completed = current_idx > phase_idx %>
        <% is_upcoming  = current_idx < phase_idx %>

        <div class="card" style="padding:0;overflow:hidden;border-color:<%= is_active ? 'var(--color-accent)' : 'var(--color-border)' %>;">
          <div style="display:flex;align-items:center;gap:0;">

            <%# Left status indicator %>
            <div style="width:4px;align-self:stretch;flex-shrink:0;background:<%= is_completed ? '#22c55e' : is_active ? 'var(--color-accent)' : 'var(--color-border)' %>;"></div>

            <div style="flex:1;padding:16px 20px;display:flex;align-items:center;gap:16px;">

              <%# Icon circle %>
              <div style="width:40px;height:40px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:<%= is_completed ? '#dcfce7' : is_active ? '#fff5f0' : 'var(--color-surface-alt)' %>;">
                <% if is_completed %>
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#22c55e" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <% else %>
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="<%= is_active ? 'var(--color-accent)' : 'var(--color-text-secondary)' %>" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="<%= phase[:icon] %>"/></svg>
                <% end %>
              </div>

              <%# Content %>
              <div style="flex:1;">
                <div style="font-size:14px;font-weight:600;margin-bottom:2px;color:<%= is_upcoming ? 'var(--color-text-secondary)' : 'var(--color-text)' %>;">
                  <%= phase[:label] %>
                  <% if is_active %><span style="font-size:11px;font-weight:600;color:var(--color-accent);margin-left:8px;background:#fff5f0;padding:2px 8px;border-radius:var(--radius-pill);">Em andamento</span><% end %>
                </div>
                <div style="font-size:12px;color:var(--color-text-secondary);"><%= phase[:desc] %></div>
              </div>

              <%# Date range %>
              <div style="text-align:right;font-size:12px;color:var(--color-text-secondary);min-width:140px;">
                <% if phase[:start] %>
                  <div style="font-weight:500;"><%= phase[:start].strftime("%d/%m") %> – <%= phase[:end]&.strftime("%d/%m/%Y") || "—" %></div>
                <% end %>
                <div style="margin-top:2px;"><%= phase[:stat] %></div>
              </div>

            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%# Quick actions for current phase %>
    <% if @cycle.nominations_open? %>
      <div class="card" style="margin-top:20px;background:var(--color-surface-alt);border-style:dashed;">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <div>
            <div style="font-size:14px;font-weight:600;margin-bottom:2px;">Fase atual: Indicações abertas</div>
            <div style="font-size:13px;color:var(--color-text-secondary);">Colaboradores devem indicar seus pares para avaliação.</div>
          </div>
          <div style="display:flex;gap:8px;">
            <%= link_to "Minhas indicações", cycle_nominations_path(@cycle), class: "btn btn-primary" %>
            <%= link_to "Validar (gestor)", validate_index_cycle_nominations_path(@cycle),
                  style: "font-size:13px;font-weight:600;color:var(--color-text-secondary);text-decoration:none;padding:8px 16px;border:1px solid var(--color-border);border-radius:var(--radius-pill);" %>
          </div>
        </div>
      </div>
    <% elsif @cycle.validating? %>
      <div class="card" style="margin-top:20px;background:var(--color-surface-alt);border-style:dashed;">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <div>
            <div style="font-size:14px;font-weight:600;margin-bottom:2px;">Fase atual: Validação de indicações</div>
            <div style="font-size:13px;color:var(--color-text-secondary);">Gestores devem aprovar ou rejeitar as indicações do seu time.</div>
          </div>
          <%= link_to "Validar indicações →", validate_index_cycle_nominations_path(@cycle), class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>

    <%# Progress bar for evaluation phase %>
    <% if @cycle.evaluation_open? && @stats[:evaluations] > 0 %>
      <% pct = (@stats[:completed].to_f / @stats[:evaluations] * 100).round %>
      <div class="card" style="margin-top:20px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <span style="font-size:14px;font-weight:600;">Progresso das avaliações</span>
          <span style="font-size:13px;font-weight:700;color:var(--color-accent);"><%= pct %>%</span>
        </div>
        <div style="height:8px;background:var(--color-surface-alt);border-radius:4px;overflow:hidden;">
          <div style="height:100%;width:<%= pct %>%;background:var(--color-accent);border-radius:4px;transition:width .4s;"></div>
        </div>
        <div style="font-size:12px;color:var(--color-text-secondary);margin-top:6px;"><%= @stats[:completed] %> de <%= @stats[:evaluations] %> avaliações concluídas</div>
      </div>
    <% end %>

  </main>
</div>
