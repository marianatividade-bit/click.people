<% content_for :title, "Avaliação de Desempenho — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "cycles" %>

  <main class="app-content">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
      <div>
        <h1 class="page-title" style="margin-bottom:4px;">Avaliação de Desempenho</h1>
        <p class="page-subtitle" style="margin:0;">Gerencie os ciclos semestrais de avaliação.</p>
      </div>
      <%= link_to "+ Novo ciclo", new_cycle_path, class: "btn btn-primary" %>
    </div>

    <div style="margin-top:28px;">
      <% if @cycles.empty? %>
        <div class="card" style="text-align:center;padding:56px 24px;">
          <div style="width:56px;height:56px;border-radius:50%;background:var(--color-surface-alt);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="var(--color-text-secondary)" stroke-width="1.5"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          </div>
          <p style="font-size:15px;font-weight:600;margin:0 0 6px;">Nenhum ciclo criado ainda</p>
          <p style="font-size:13px;color:var(--color-text-secondary);margin:0 0 20px;">Crie o primeiro ciclo para iniciar o processo de avaliação.</p>
          <%= link_to "+ Criar primeiro ciclo", new_cycle_path, class: "btn btn-primary" %>
        </div>

      <% else %>
        <div class="card" style="padding:0;overflow:hidden;">
          <table style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="border-bottom:1px solid var(--color-border);">
                <th style="text-align:left;padding:12px 20px;font-size:12px;font-weight:600;color:var(--color-text-secondary);letter-spacing:0.3px;white-space:nowrap;">
                  Nome
                  <span style="color:var(--color-border);margin-left:4px;">⇅</span>
                </th>
                <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--color-text-secondary);letter-spacing:0.3px;">Status</th>
                <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--color-text-secondary);letter-spacing:0.3px;">
                  Etapa
                  <span style="color:var(--color-border);margin-left:4px;">⇅</span>
                </th>
                <th style="text-align:left;padding:12px 16px;font-size:12px;font-weight:600;color:var(--color-text-secondary);letter-spacing:0.3px;white-space:nowrap;">Criado em</th>
                <th style="padding:12px 20px;"></th>
              </tr>
            </thead>
            <tbody>
              <% @cycles.each do |cycle| %>
                <%
                  status_label = {
                    "draft"            => "Rascunho",
                    "nominations_open" => "Indicações",
                    "validating"       => "Validação",
                    "evaluation_open"  => "No ar",
                    "calibration"      => "Calibração",
                    "closed"           => "Encerrado",
                  }[cycle.status] || cycle.status.humanize

                  phase_label = {
                    "draft"            => "Esperando configuração",
                    "nominations_open" => "Indicações abertas",
                    "validating"       => "Validando indicações",
                    "evaluation_open"  => "Avaliações em andamento",
                    "calibration"      => "Em calibração",
                    "closed"           => "Relatório disponível",
                  }[cycle.status] || "—"

                  badge_style = {
                    "draft"            => "background:#f5f5f5;color:#6b6b6b;",
                    "nominations_open" => "background:#fef3c7;color:#92400e;",
                    "validating"       => "background:#ede9fe;color:#4c1d95;",
                    "evaluation_open"  => "background:#dcfce7;color:#14532d;",
                    "calibration"      => "background:#dbeafe;color:#1e3a5f;",
                    "closed"           => "background:#f0f0f0;color:#444;",
                  }[cycle.status] || "background:#f5f5f5;color:#6b6b6b;"
                %>
                <tr class="cycle-table-row" style="border-bottom:1px solid var(--color-border);">

                  <%# Nome %>
                  <td style="padding:14px 20px;">
                    <% if cycle.nominations_open? || cycle.evaluation_open? || cycle.calibration? %>
                      <%= link_to cycle.name, cycle_path(cycle),
                            style: "font-size:14px;font-weight:600;color:var(--color-accent);text-decoration:none;" %>
                    <% else %>
                      <span style="font-size:14px;font-weight:500;color:var(--color-text);"><%= cycle.name %></span>
                    <% end %>
                    <% participant_count = cycle.cycle_participants.count %>
                    <% if participant_count > 0 %>
                      <div style="font-size:11px;color:var(--color-text-secondary);margin-top:2px;"><%= participant_count %> participantes</div>
                    <% end %>
                  </td>

                  <%# Status badge %>
                  <td style="padding:14px 16px;">
                    <span style="display:inline-block;font-size:12px;font-weight:600;padding:3px 10px;border-radius:var(--radius-pill);<%= badge_style %>">
                      <%= status_label %>
                    </span>
                  </td>

                  <%# Etapa %>
                  <td style="padding:14px 16px;font-size:13px;color:var(--color-text-secondary);">
                    <%= phase_label %>
                  </td>

                  <%# Criado em %>
                  <td style="padding:14px 16px;font-size:12px;color:var(--color-text-secondary);white-space:nowrap;">
                    <%= cycle.created_at.strftime("%-d/%-m/%y %H:%M") %>
                  </td>

                  <%# Ações com ícones e tooltips %>
                  <td style="padding:14px 20px;">
                    <div style="display:flex;align-items:center;gap:4px;justify-content:flex-end;">

                      <%# Ver %>
                      <div class="icon-action-wrap" title="Ver detalhes">
                        <%= link_to cycle_path(cycle), class: "icon-action" do %>
                          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <% end %>
                      </div>

                      <%# Configurar %>
                      <div class="icon-action-wrap" title="Configurar ciclo">
                        <%= link_to configure_cycle_path(cycle), class: "icon-action" do %>
                          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
                        <% end %>
                      </div>

                      <%# Duplicar %>
                      <div class="icon-action-wrap" title="Duplicar ciclo">
                        <%= button_to duplicate_cycle_path(cycle), method: :patch, class: "icon-action",
                              data: { confirm: "Duplicar \"#{cycle.name}\"?" } do %>
                          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                        <% end %>
                      </div>

                      <%# Excluir (só rascunho) %>
                      <% if cycle.draft? %>
                        <div class="icon-action-wrap" title="Excluir ciclo">
                          <%= button_to cycle_path(cycle), method: :delete, class: "icon-action icon-action--danger",
                                data: { confirm: "Excluir \"#{cycle.name}\" permanentemente?" } do %>
                            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                          <% end %>
                        </div>
                      <% else %>
                        <div style="width:28px;"></div>
                      <% end %>

                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </main>
</div>
