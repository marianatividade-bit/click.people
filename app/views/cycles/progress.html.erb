<% content_for :title, "Progresso — #{@cycle.name}" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "cycles" %>

  <main class="app-content">
    <%= link_to "← #{@cycle.name}", cycle_path(@cycle), style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <h1 class="page-title">Progresso do ciclo</h1>
    <p class="page-subtitle"><%= @cycle.name %></p>

    <div class="stat-row" style="margin-bottom:24px;">
      <div class="stat-card">
        <div class="stat-label">Avaliações enviadas</div>
        <div class="stat-value"><%= @submitted_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total de pessoas</div>
        <div class="stat-value"><%= @total_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Conclusão</div>
        <div class="stat-value"><%= @completion %>%</div>
      </div>
    </div>

    <div class="card" style="max-width:640px;margin-bottom:24px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <span style="font-size:14px;font-weight:700;">Progresso geral</span>
        <span style="font-size:14px;font-weight:700;color:var(--color-accent);"><%= @completion %>%</span>
      </div>
      <div class="progress-bar-wrap" style="height:12px;">
        <div class="progress-bar-fill" style="width:<%= @completion %>%;height:12px;border-radius:6px;"></div>
      </div>
    </div>

    <% if @pending_people.any? %>
      <div class="card" style="max-width:640px;">
        <div style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:var(--color-text-secondary);margin-bottom:12px;">
          Aguardando avaliação (<%= @pending_people.count %>)
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;">
          <% @pending_people.each do |person| %>
            <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--color-border);">
              <div style="width:28px;height:28px;border-radius:50%;background:var(--color-surface-alt);border:1px solid var(--color-border);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--color-text-secondary);flex-shrink:0;">
                <%= person.name.split(" ").first(2).map{|n|n[0]}.join %>
              </div>
              <div style="flex:1;">
                <div style="font-size:14px;font-weight:600;"><%= person.name %></div>
                <div style="font-size:12px;color:var(--color-text-secondary);"><%= person.role.humanize %></div>
              </div>
              <span class="cycle-badge" style="background:rgba(245,124,0,0.1);color:var(--color-warning);">Pendente</span>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="card" style="max-width:640px;text-align:center;padding:32px;">
        <p style="color:var(--color-success);font-weight:600;font-size:15px;margin:0;">
          Todas as avaliações foram enviadas!
        </p>
      </div>
    <% end %>
  </main>
</div>
