<% content_for :title, "Minhas indicações — #{@cycle.name}" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "cycles" %>

  <main class="app-content">
    <%= link_to "← #{@cycle.name}", cycle_path(@cycle), style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px;">
      <div>
        <h1 class="page-title" style="margin-bottom:4px;">Indicações de pares</h1>
        <p class="page-subtitle" style="margin:0;">Indique colegas para te avaliar neste ciclo. Mínimo recomendado: 3 · Máximo: <%= @max %>.</p>
      </div>
      <span class="cycle-badge cycle-badge--nominations_open"><%= @cycle.name %></span>
    </div>

    <% unless @can_nominate %>
      <div style="padding:16px 20px;background:#fef3c7;border-left:3px solid #f59e0b;border-radius:var(--radius-md);margin-bottom:24px;">
        <p style="margin:0;font-size:14px;color:#92400e;">
          <% if !@cycle.nominations_open? %>
            As indicações não estão abertas no momento.
          <% else %>
            Você não está cadastrado como participante deste ciclo. Fale com o RH.
          <% end %>
        </p>
      </div>
    <% end %>

    <div style="display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start;max-width:900px;">

      <%# Left: current nominations %>
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <h2 style="font-size:14px;font-weight:700;margin:0;">Suas indicações</h2>
          <span style="font-size:13px;color:var(--color-text-secondary);"><%= @my_nominations.count %>/<%= @max %></span>
        </div>

        <% if @my_nominations.any? %>
          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
            <% @my_nominations.each do |nom| %>
              <div class="card" style="padding:12px 16px;display:flex;align-items:center;gap:12px;">
                <%= person_avatar(nom.nominee, size: 36) %>
                <div style="flex:1;">
                  <div style="font-size:14px;font-weight:600;"><%= nom.nominee.name %></div>
                  <div style="font-size:12px;color:var(--color-text-secondary);"><%= nom.nominee.email %></div>
                </div>
                <% badge_style = { "pending" => "background:#fef3c7;color:#92400e;", "approved" => "background:#dcfce7;color:#14532d;", "rejected" => "background:#fee2e2;color:#991b1b;" }[nom.status] %>
                <span style="font-size:11px;font-weight:600;padding:3px 10px;border-radius:var(--radius-pill);<%= badge_style %>">
                  <%= { "pending" => "Aguardando", "approved" => "Aprovada", "rejected" => "Rejeitada" }[nom.status] %>
                </span>
                <% if nom.pending? && @can_nominate %>
                  <%= button_to "Remover", cycle_nomination_path(@cycle, nom),
                        method: :delete,
                        style: "font-size:12px;color:#e53e3e;background:none;border:none;cursor:pointer;padding:4px 8px;",
                        data: { confirm: "Remover indicação de #{nom.nominee.name}?" } %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card" style="padding:32px;text-align:center;margin-bottom:16px;">
            <p style="color:var(--color-text-secondary);margin:0;font-size:13px;">Nenhuma indicação feita ainda.<br>Selecione colegas ao lado.</p>
          </div>
        <% end %>
      </div>

      <%# Right: search and add %>
      <% if @can_nominate && @my_nominations.count < @max %>
        <div class="card" style="padding:20px;">
          <p style="font-size:13px;font-weight:600;margin:0 0 12px;">Adicionar indicação</p>
          <input type="text" id="search-people" placeholder="Buscar por nome..."
                 class="form-input" style="margin-bottom:12px;"
                 oninput="filterPeople(this.value)">

          <div id="people-list" style="max-height:380px;overflow-y:auto;display:flex;flex-direction:column;gap:4px;">
            <%
              nominated_ids = @my_nominations.map(&:nominee_id)
            %>
            <% @all_people.each do |person| %>
              <% already = nominated_ids.include?(person.id) %>
              <div class="person-item" data-name="<%= person.name.downcase %>"
                   style="display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:var(--radius-md);background:<%= already ? 'var(--color-surface-alt)' : '#fff' %>;">
                <%= person_avatar(person, size: 32) %>
                <div style="flex:1;min-width:0;">
                  <div style="font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= person.name %></div>
                </div>
                <% if already %>
                  <span style="font-size:11px;color:var(--color-text-secondary);">✓</span>
                <% else %>
                  <%= button_to "+", cycle_nominations_path(@cycle),
                        params: { nominee_id: person.id },
                        method: :post,
                        style: "width:24px;height:24px;border-radius:50%;background:var(--color-accent);color:#fff;font-size:16px;font-weight:700;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;line-height:1;" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </main>
</div>

<script>
  function filterPeople(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('.person-item').forEach(el => {
      el.style.display = el.dataset.name.includes(q) ? 'flex' : 'none';
    });
  }
</script>
