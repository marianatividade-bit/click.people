<% content_for :title, "Novo PDI — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "pdis" %>

  <main class="app-content">
    <%= link_to "← PDIs", pdis_path, style: "font-size:14px;color:var(--color-text-secondary);text-decoration:none;display:inline-block;margin-bottom:24px;" %>

    <h1 class="page-title">Novo PDI</h1>

    <%= form_with model: @pdi, local: true do |f| %>
      <div class="card" style="max-width:600px;margin-bottom:16px;">
        <div class="form-field">
          <%= f.label :title, "Título", class: "form-label" %>
          <%= f.text_field :title, class: "form-input", placeholder: "Ex: Desenvolver habilidades de liderança" %>
        </div>
        <div class="form-field">
          <%= f.label :description, "Descrição", class: "form-label" %>
          <%= f.text_area :description, rows: 4, class: "form-input", placeholder: "Descreva o objetivo deste plano..." %>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-field" style="margin-bottom:0;">
            <%= f.label :due_date, "Data limite", class: "form-label" %>
            <%= f.date_field :due_date, class: "form-input" %>
          </div>
          <div class="form-field" style="margin-bottom:0;">
            <%= f.label :cycle_id, "Ciclo (opcional)", class: "form-label" %>
            <%= f.select :cycle_id, @cycles.map{|c| [c.name, c.id]}, { include_blank: "Sem vínculo" }, class: "form-input" %>
          </div>
        </div>
      </div>

      <div style="display:flex;gap:12px;">
        <%= f.submit "Criar PDI", class: "btn btn-primary" %>
        <%= link_to "Cancelar", pdis_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </main>
</div>
