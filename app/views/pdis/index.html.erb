<% content_for :title, "PDIs — Click.People" %>

<div class="app-shell">
  <%= render "shared/sidebar", active: "pdis" %>

  <main class="app-content">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
      <div>
        <h1 class="page-title" style="margin-bottom:4px;">Planos de Desenvolvimento</h1>
        <p class="page-subtitle" style="margin:0;"><%= @owner ? "Seus PDIs" : "Todos os PDIs" %></p>
      </div>
      <%= link_to "Novo PDI", new_pdi_path, class: "btn btn-primary" %>
    </div>

    <% if @pdis.any? %>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <% @pdis.each do |pdi| %>
          <%= link_to pdi_path(pdi), style: "text-decoration:none;" do %>
            <div class="card" style="display:flex;align-items:center;gap:16px;padding:16px 20px;">
              <div style="flex:1;">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
                  <span style="font-size:15px;font-weight:700;color:var(--color-text);"><%= pdi.title %></span>
                  <span class="pdi-badge pdi-badge--<%= pdi.status %>"><%= { "not_started" => "Não iniciado", "in_progress" => "Em andamento", "done" => "Concluído", "cancelled" => "Cancelado" }[pdi.status] || pdi.status %></span>
                </div>
                <% if @owner.nil? %>
                  <div style="font-size:12px;color:var(--color-text-secondary);margin-bottom:6px;"><%= pdi.person.name %></div>
                <% end %>
                <div class="progress-bar-wrap">
                  <div class="progress-bar-fill" style="width:<%= pdi.progress_percent %>%;"></div>
                </div>
              </div>
              <div style="text-align:right;flex-shrink:0;">
                <div style="font-size:20px;font-weight:700;"><%= pdi.progress_percent %>%</div>
                <div style="font-size:11px;color:var(--color-text-secondary);">concluído</div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card" style="text-align:center;padding:48px;">
        <p style="color:var(--color-text-secondary);margin:0 0 16px;">Nenhum PDI encontrado.</p>
        <%= link_to "Criar primeiro PDI", new_pdi_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </main>
</div>
