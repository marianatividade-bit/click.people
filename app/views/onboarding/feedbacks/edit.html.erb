<% content_for :active_nav, "onboarding_evaluations" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Editar Feedback</h1>
    <p class="page-subtitle"><%= @feedback.person.name %></p>
  </div>
</div>

<div style="max-width:680px;">
  <div class="card" style="padding:28px;">
    <%= form_with model: [:onboarding, @feedback] do |f| %>
      <div style="margin-bottom:16px;">
        <%= f.label :meeting_at, "Data da reunião", style:"display:block; font-size:13px; font-weight:600; margin-bottom:6px;" %>
        <%= f.datetime_local_field :meeting_at, style:"padding:10px 12px; border:1px solid var(--color-border); border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans);" %>
      </div>

      <div style="margin-bottom:16px;">
        <label style="display:block; font-size:13px; font-weight:600; margin-bottom:4px;">ID do evento Google Calendar</label>
        <%= f.text_field :calendar_event_id, placeholder: "ID do evento (opcional)", style:"padding:10px 12px; border:1px solid var(--color-border); border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans);" %>
      </div>

      <div style="margin-bottom:16px;">
        <%= f.label :public_notes, "Notas públicas", style:"display:block; font-size:13px; font-weight:600; margin-bottom:4px;" %>
        <p style="font-size:12px; color:var(--color-text-secondary); margin-bottom:8px;">Visíveis para o colaborador e líder.</p>
        <%= f.text_area :public_notes, rows: 4, style:"padding:10px 12px; border:1px solid var(--color-border); border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans); resize:vertical;" %>
      </div>

      <div style="margin-bottom:24px;">
        <%= f.label :private_notes, "Notas privadas", style:"display:block; font-size:13px; font-weight:600; margin-bottom:4px;" %>
        <p style="font-size:12px; color:var(--color-text-secondary); margin-bottom:8px;">
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="vertical-align:middle;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          Visíveis apenas para o líder, RH e Business Partner.
        </p>
        <%= f.text_area :private_notes, rows: 4, style:"padding:10px 12px; border:1px solid #fce8e0; border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans); resize:vertical;" %>
      </div>

      <div style="display:flex; align-items:center; justify-content:space-between;">
        <%= link_to "Cancelar", onboarding_feedback_path(@feedback), class: "btn btn-secondary" %>
        <%= f.submit "Salvar alterações", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
