<% content_for :active_nav, "onboarding_evaluations" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Feedback de Encerramento</h1>
    <p class="page-subtitle"><%= @feedback.person.name %> · Líder: <%= @feedback.leader.name %></p>
  </div>
  <div style="display:flex; gap:8px;">
    <% if @feedback.leader == current_person || current_person.hr_admin? || current_person.business_partner? %>
      <%= link_to "Editar", edit_onboarding_feedback_path(@feedback), class: "btn btn-secondary" %>
    <% end %>
    <% if !@feedback.completed? && (@feedback.leader == current_person) %>
      <%= button_to "Marcar como concluído", onboarding_feedback_path(@feedback),
            method: :patch, params: { mark_complete: true, experience_feedback: { status: "completed" } },
            class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<div style="display:grid; grid-template-columns:1fr 280px; gap:24px; align-items:start;">
  <div>
    <%# === Notas públicas === %>
    <div class="card" style="padding:24px; margin-bottom:16px;">
      <h2 style="font-size:15px; font-weight:600; margin-bottom:16px;">Notas públicas</h2>
      <p style="font-size:13px; color:var(--color-text-secondary); margin-bottom:12px;">Visível para o líder e o colaborador.</p>
      <% if @feedback.public_notes.present? %>
        <p style="font-size:14px; color:#1a1a1a; line-height:1.6; margin:0; white-space:pre-wrap;"><%= @feedback.public_notes %></p>
      <% else %>
        <p style="font-size:14px; color:var(--color-text-secondary); font-style:italic;">Nenhuma nota pública registrada.</p>
      <% end %>
    </div>

    <%# === Notas privadas (somente quem pode ver) === %>
    <% if @feedback.can_see_private_notes?(current_person) %>
      <div class="card" style="padding:24px; border:1px solid #fce8e0;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-accent)" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          <h2 style="font-size:15px; font-weight:600;">Notas privadas</h2>
          <span style="font-size:11px; background:#fce8e0; color:var(--color-accent); padding:2px 8px; border-radius:20px; font-weight:600;">Restrito ao líder e RH</span>
        </div>
        <% if @feedback.private_notes.present? %>
          <p style="font-size:14px; color:#1a1a1a; line-height:1.6; margin:0; white-space:pre-wrap;"><%= @feedback.private_notes %></p>
        <% else %>
          <p style="font-size:14px; color:var(--color-text-secondary); font-style:italic;">Nenhuma nota privada registrada.</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# === Sidebar info === %>
  <div>
    <div class="card" style="padding:20px;">
      <h3 style="font-size:13px; font-weight:600; color:var(--color-text-secondary); text-transform:uppercase; letter-spacing:.5px; margin-bottom:16px;">Detalhes</h3>
      <dl style="display:flex; flex-direction:column; gap:12px; font-size:13px;">
        <div>
          <dt style="color:var(--color-text-secondary); margin-bottom:2px;">Status</dt>
          <dd style="font-weight:600; color:<%= @feedback.completed? ? '#2e7d32' : @feedback.scheduled? ? '#1565c0' : '#f57f17' %>;">
            <%= @feedback.completed? ? "Concluído" : @feedback.scheduled? ? "Agendado" : "Pendente" %>
          </dd>
        </div>
        <% if @feedback.meeting_at %>
          <div>
            <dt style="color:var(--color-text-secondary); margin-bottom:2px;">Data da reunião</dt>
            <dd style="font-weight:500;"><%= l(@feedback.meeting_at, format: :long) %></dd>
          </div>
        <% end %>
        <% if @feedback.calendar_event_id.present? %>
          <div>
            <dt style="color:var(--color-text-secondary); margin-bottom:2px;">Google Calendar</dt>
            <dd>
              <a href="https://calendar.google.com/calendar/event?eid=<%= @feedback.calendar_event_id %>"
                 target="_blank" rel="noopener"
                 style="color:var(--color-accent); font-size:13px; text-decoration:none; font-weight:500;">
                Abrir evento ↗
              </a>
            </dd>
          </div>
        <% end %>
        <% if @feedback.completed_at %>
          <div>
            <dt style="color:var(--color-text-secondary); margin-bottom:2px;">Concluído em</dt>
            <dd style="font-weight:500;"><%= l(@feedback.completed_at, format: :short) %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</div>
