<% content_for :active_nav, "onboarding_evaluations" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Feedback de Encerramento</h1>
    <p class="page-subtitle">Feedback ao final dos 3 meses de experiência</p>
  </div>
  <% if current_person.manager? || current_person.hr_admin? || current_person.business_partner? %>
    <%= link_to new_onboarding_feedback_path, class: "btn btn-primary" do %>
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Novo feedback
    <% end %>
  <% end %>
</div>

<% if @feedbacks.empty? %>
  <div class="empty-state">
    <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="var(--color-accent)" stroke-width="1.5"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    <h3>Nenhum feedback ainda</h3>
    <p>Feedbacks de encerramento de experiência aparecem aqui quando criados pelo líder.</p>
  </div>
<% else %>
  <div style="display:flex; flex-direction:column; gap:12px;">
    <% @feedbacks.each do |fb| %>
      <div class="card" style="padding:20px; display:flex; align-items:center; gap:16px;">
        <div style="width:44px; height:44px; border-radius:50%; background:var(--color-bg-secondary); display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:700; color:var(--color-accent); flex-shrink:0;">
          <%= fb.person.name.split.map(&:first).first(2).join.upcase %>
        </div>
        <div style="flex:1;">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:2px;">
            <span style="font-size:14px; font-weight:600;"><%= fb.person.name %></span>
            <span style="font-size:11px; font-weight:600; padding:2px 8px; border-radius:20px;
              background:<%= fb.completed? ? '#e8f5e9' : fb.scheduled? ? '#e3f2fd' : '#fff8e1' %>;
              color:<%= fb.completed? ? '#2e7d32' : fb.scheduled? ? '#1565c0' : '#f57f17' %>;">
              <%= fb.completed? ? "Concluído" : fb.scheduled? ? "Agendado" : "Pendente" %>
            </span>
          </div>
          <div style="font-size:12px; color:var(--color-text-secondary);">
            Líder: <%= fb.leader.name %>
            <% if fb.meeting_at %> · Reunião: <%= l(fb.meeting_at, format: :short) %><% end %>
          </div>
        </div>
        <%= link_to "Ver", onboarding_feedback_path(fb), class: "btn btn-secondary", style:"padding:6px 14px; font-size:13px; flex-shrink:0;" %>
      </div>
    <% end %>
  </div>
<% end %>
