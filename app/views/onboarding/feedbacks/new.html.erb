<% content_for :active_nav, "onboarding_evaluations" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Novo Feedback de Encerramento</h1>
    <p class="page-subtitle">Feedback ao final dos 3 meses de experiência</p>
  </div>
</div>

<div style="max-width:680px;">
  <div class="card" style="padding:28px;">
    <%= form_with model: [:onboarding, @feedback] do |f| %>
      <% if @feedback.errors.any? %>
        <div style="background:#fce8e0; border-radius:8px; padding:12px 16px; margin-bottom:20px; font-size:14px; color:#c0390e;">
          <%= @feedback.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div style="margin-bottom:16px;">
        <%= f.label :person_id, "Colaborador", style:"display:block; font-size:13px; font-weight:600; margin-bottom:6px;" %>
        <%= f.select :person_id, options_from_collection_for_select(@people, :id, :name),
              { prompt: "Selecionar colaborador" },
              style: "padding:10px 12px; border:1px solid var(--color-border); border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans);" %>
      </div>

      <div style="margin-bottom:16px;">
        <%= f.label :meeting_at, "Data da reunião de feedback", style:"display:block; font-size:13px; font-weight:600; margin-bottom:6px;" %>
        <%= f.datetime_local_field :meeting_at, style:"padding:10px 12px; border:1px solid var(--color-border); border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans);" %>
      </div>

      <div style="margin-bottom:16px;">
        <label style="display:block; font-size:13px; font-weight:600; margin-bottom:4px;">Agendar no Google Calendar</label>
        <p style="font-size:12px; color:var(--color-text-secondary); margin-bottom:8px;">Cole o ID do evento após criar no Google Calendar (opcional).</p>
        <%= f.text_field :calendar_event_id, placeholder: "ID do evento (ex: abc123xyz)", style:"padding:10px 12px; border:1px solid var(--color-border); border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans);" %>
      </div>

      <div style="margin-bottom:16px;">
        <%= f.label :public_notes, "Notas públicas", style:"display:block; font-size:13px; font-weight:600; margin-bottom:4px;" %>
        <p style="font-size:12px; color:var(--color-text-secondary); margin-bottom:8px;">Visíveis para o colaborador e líder.</p>
        <%= f.text_area :public_notes, rows: 4, placeholder: "Pontos fortes, conquistas, expectativas para o futuro...", style:"padding:10px 12px; border:1px solid var(--color-border); border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans); resize:vertical;" %>
      </div>

      <div style="margin-bottom:24px;">
        <%= f.label :private_notes, "Notas privadas", style:"display:block; font-size:13px; font-weight:600; margin-bottom:4px;" %>
        <p style="font-size:12px; color:var(--color-text-secondary); margin-bottom:8px;">
          <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="vertical-align:middle;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          Visíveis apenas para o líder, RH e Business Partner.
        </p>
        <%= f.text_area :private_notes, rows: 4, placeholder: "Observações confidenciais, pontos de atenção para o RH...", style:"padding:10px 12px; border:1px solid #fce8e0; border-radius:8px; font-size:14px; width:100%; font-family:var(--font-sans); resize:vertical;" %>
      </div>

      <div style="display:flex; align-items:center; justify-content:space-between;">
        <%= link_to "Cancelar", onboarding_feedbacks_path, class: "btn btn-secondary" %>
        <%= f.submit "Salvar feedback", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
